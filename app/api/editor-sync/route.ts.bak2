import { NextRequest, NextResponse } from "next/server";
import fs from "fs";
import path from "path";

const PAGE_MAP: Record<string, string> = {
  home: path.join(process.cwd(), "components", "home", "HeroSection.tsx"),
  "how-it-works": path.join(process.cwd(), "app", "how-it-works", "page.tsx"),
  delivery: path.join(process.cwd(), "app", "delivery", "page.tsx"),
  about: path.join(process.cwd(), "app", "about", "page.tsx"),
  faq: path.join(process.cwd(), "app", "faq", "page.tsx"),
  contacts: path.join(process.cwd(), "app", "contacts", "page.tsx"),
  subscription: path.join(process.cwd(), "app", "subscription", "page.tsx"),
  cart: path.join(process.cwd(), "app", "cart", "page.tsx"),
  menu: path.join(process.cwd(), "app", "menu", "page.tsx"),
  dashboard: path.join(process.cwd(), "app", "dashboard", "page.tsx"),
};

export async function GET(req: NextRequest) {
  const page = req.nextUrl.searchParams.get("page") || "home";
  const filePath = PAGE_MAP[page] || PAGE_MAP["home"];
  const content = fs.readFileSync(filePath, "utf8");

  const parseArray = (name: string) => {
    let start = content.indexOf(`const ${name} = [`);
    if (start === -1) start = content.indexOf(`const ${name}:`);
    if (start === -1) return [];
    const eqBracket = content.indexOf("= [", start); const bracketStart = eqBracket !== -1 ? eqBracket + 2 : content.indexOf("[", start);
    let depth = 0, end = bracketStart;
    for (let i = bracketStart; i < content.length; i++) {
      if (content[i] === "[") depth++;
      else if (content[i] === "]") { depth--; if (depth === 0) { end = i + 1; break; } }
    }
    const block = content.slice(bracketStart, end);
    const matches = [...block.matchAll(/\{([^}]+)\}/g)];
    return matches.map(m => {
      const p = (k: string) => {
        const match = m[1].match(new RegExp(`${k}:\\s*([^,}]+)`));
        return match ? match[1].trim() : "";
      };
      return {
        src: p("src").replace(/'/g, ""),
        top: Number(p("top")),
        left: Number(p("left")),
        w: Number(p("w")),
        rotate: Number(p("rotate")),
      };
    });
  };

  if (page === "home") {
    const blockIds = ["block-title","block-tags","block-btns","block-fresh","block-fresh-tag-1","block-delivery","block-delivery-tag-1","block-delivery-tag-2","block-how","block-how-steps","block-why","block-why-tags","block-ai","block-ai-tag-1","block-ai-btn","block-sub","block-sub-input","block-sub-btn","block-sub-tag-1","block-social","block-social-links","block-footer"];
    const blocks = blockIds.map(id => {
      const marker = `{/* BLOCK:${id} */}`;
      const mi = content.indexOf(marker);
      if (mi === -1) return { id, top: 0, left: 0, w: 0 };
      const after = content.slice(mi);
      const m = after.match(/top: (\d+), left: (\d+)/);
      const wm = after.match(/maxWidth: '(\d+)px'|width: (\d+)/);
      return { id, top: m ? Number(m[1]) : 0, left: m ? Number(m[2]) : 0, w: wm ? Number(wm[1] || wm[2]) : 0 };
    });
    return NextResponse.json({
      brushes: parseArray("brushes"),
      drops: parseArray("drops"),
      veggies: parseArray("veggies"),
      dishes: parseArray("dishes"),
      blocks,
    });
  }

  const pageBlockIds: Record<string, string[]> = {
    "delivery": ["del-header","del-zone","del-price","del-time","del-late","del-cta"],
    "how-it-works": ["hiw-header","hiw-steps","hiw-cta"],
  };
  const blockIds = pageBlockIds[page] || [];
  const blocks = blockIds.map(id => {
    const marker = `{/* BLOCK:${id} */}`;
    const mi = content.indexOf(marker);
    if (mi === -1) return { id, top: 0, left: 0, w: 0 };
    const after = content.slice(mi);
    const m = after.match(/top: (\d+), left: (\d+), width: (\d+)/);
    return { id, top: m ? Number(m[1]) : 0, left: m ? Number(m[2]) : 0, w: m ? Number(m[3]) : 0 };
  });
  return NextResponse.json({
    brushes: parseArray("pageDekor_brushes"),
    drops: parseArray("pageDekor_drops"),
    veggies: parseArray("pageDekor_veggies"),
    dishes: parseArray("pageDekor_dishes"),
    blocks,
  });
}

export async function POST(req: NextRequest) {
  const { elements, page } = await req.json();
  const filePath = PAGE_MAP[page] || PAGE_MAP["home"];
  let content = fs.readFileSync(filePath, "utf8");

  const brushes = elements.filter((e: any) => e.type === "brush");
  const drops   = elements.filter((e: any) => e.type === "drop");
  const veggies = elements.filter((e: any) => e.type === "veggie");
  const dishes  = elements.filter((e: any) => e.type === "dish");

  const toLine = (e: any) =>
    `  { src: '${e.src}', top: ${e.y}, left: ${e.x}, w: ${e.w}, rotate: ${e.rotate} },`;

  const replaceArray = (c: string, name: string, items: any[]) => {
    const start = c.indexOf(`const ${name} = [`);
    if (start === -1) return c;
    const end = c.indexOf("]", start) + 1;
    const newBlock = `const ${name} = [\n${items.map(e => toLine(e)).join("\n")}\n]`;
    return c.slice(0, start) + newBlock + c.slice(end);
  };

  if (page === "home") {
    content = replaceArray(content, "brushes", brushes);
    content = replaceArray(content, "drops", drops);
    content = replaceArray(content, "veggies", veggies);
    content = replaceArray(content, "dishes", dishes);
    const blocks = elements.filter((e: any) => e.type === "block" || e.type === "tag");
    for (const b of blocks) {
      const marker = `{/* BLOCK:${b.id} */}`;
      const markerIdx = content.indexOf(marker);
      if (markerIdx === -1) continue;
      const after = content.slice(markerIdx);
      const styleMatch = after.match(/style=\{\{[^\n]*position: 'absolute'[^\n]*top: (\d+)[^\n]*left: (\d+)/);
      if (!styleMatch) continue;
      const styleIdx = markerIdx + after.indexOf(styleMatch[0]);
      const oldStyle = styleMatch[0];
      const newStyle = oldStyle
        .replace(/top: \d+/, `top: ${Math.round(b.y)}`)
        .replace(/left: \d+/, `left: ${Math.round(b.x)}`);
      content = content.slice(0, styleIdx) + newStyle + content.slice(styleIdx + oldStyle.length);
    }
  } else {
    content = replaceArray(content, "pageDekor_brushes", brushes);
    content = replaceArray(content, "pageDekor_drops", drops);
    content = replaceArray(content, "pageDekor_veggies", veggies);
    content = replaceArray(content, "pageDekor_dishes", dishes);
    const blocks = elements.filter((e: any) => e.type === "block" || e.type === "tag");
    for (const b of blocks) {
      const marker = `{/* BLOCK:${b.id} */}`;
      const markerIdx = content.indexOf(marker);
      if (markerIdx === -1) continue;
      const after = content.slice(markerIdx);
      const styleMatch = after.match(/style=\{\{ position: 'absolute', top: (\d+), left: (\d+), width: (\d+)/);
      if (!styleMatch) continue;
      const styleIdx = markerIdx + after.indexOf(styleMatch[0]);
      const oldStyle = styleMatch[0];
      const newStyle = oldStyle
        .replace(/top: \d+/, `top: ${Math.round(b.y)}`)
        .replace(/left: \d+/, `left: ${Math.round(b.x)}`);
      content = content.slice(0, styleIdx) + newStyle + content.slice(styleIdx + oldStyle.length);
    }
  }

  fs.writeFileSync(filePath, content, "utf8");
  return NextResponse.json({ ok: true });
}
