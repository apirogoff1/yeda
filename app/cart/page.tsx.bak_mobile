'use client'
import FloatingShapes from '@/components/home/FloatingShapes'
import { useCart } from '@/context/CartContext'
import Link from 'next/link'

export default function CartPage() {
  const { items, removeItem, updateQty, clearCart, total, count } = useCart()

  const font1 = 'var(--font-comfortaa)'
  const font2 = 'var(--font-geologica)'
  const accent = '#FF4D00'
  const dark = '#433932'
  const card = { background: 'rgba(255,255,255,0.65)', borderRadius: '32px', padding: '40px', backdropFilter: 'blur(8px)', marginBottom: '32px' }

  return (
    <main style={{ minHeight: '100vh', paddingTop: '120px', paddingBottom: '80px', position: 'relative', overflow: 'hidden' }}>
      <FloatingShapes />
      <img src="/photo_yeda/brushes/brush-blue.png" alt="" style={{ position: 'absolute', top: '0px', left: '-100px', width: '1100px', opacity: 0.4, pointerEvents: 'none', zIndex: 0, transform: 'rotate(15deg)', filter: 'blur(1.5px)' }} />
      <img src="/photo_yeda/brushes/brush-carrot.png" alt="" style={{ position: 'absolute', top: '300px', right: '-200px', width: '1000px', opacity: 0.4, pointerEvents: 'none', zIndex: 0, transform: 'rotate(-40deg)', filter: 'blur(1.5px)' }} />
      <img src="/photo_yeda/brushes/brush-ezhevika.png" alt="" style={{ position: 'absolute', top: '700px', left: '-150px', width: '1050px', opacity: 0.4, pointerEvents: 'none', zIndex: 0, transform: 'rotate(60deg)', filter: 'blur(1.5px)' }} />
      <img src="/photo_yeda/brushes/brush-lemon.png" alt="" style={{ position: 'absolute', top: '1100px', right: '-100px', width: '950px', opacity: 0.4, pointerEvents: 'none', zIndex: 0, transform: 'rotate(-70deg)', filter: 'blur(1.5px)' }} />
      <img src="/photo_yeda/brushes/brush-raspberry.png" alt="" style={{ position: 'absolute', top: '1500px', left: '-200px', width: '1100px', opacity: 0.4, pointerEvents: 'none', zIndex: 0, transform: 'rotate(130deg)', filter: 'blur(1.5px)' }} />
      <img src="/photo_yeda/brushes/brush-skyblue.png" alt="" style={{ position: 'absolute', top: '1900px', right: '-250px', width: '1000px', opacity: 0.4, pointerEvents: 'none', zIndex: 0, transform: 'rotate(-20deg)', filter: 'blur(1.5px)' }} />
      <img src="/photo_yeda/brushes/brush-strawberry.png" alt="" style={{ position: 'absolute', top: '2300px', left: '-80px', width: '1050px', opacity: 0.4, pointerEvents: 'none', zIndex: 0, transform: 'rotate(80deg)', filter: 'blur(1.5px)' }} />
      <img src="/photo_yeda/brushes/brush-zucchini.png" alt="" style={{ position: 'absolute', top: '2700px', right: '-180px', width: '1000px', opacity: 0.4, pointerEvents: 'none', zIndex: 0, transform: 'rotate(-110deg)', filter: 'blur(1.5px)' }} />

      <div style={{ position: 'relative', zIndex: 2, maxWidth: '900px', margin: '0 auto', padding: '0 24px' }}>
        <div style={{ textAlign: 'center', marginBottom: '48px' }}>
          <h1 style={{ fontFamily: font1, fontSize: '48px', fontWeight: 900, color: accent, lineHeight: 1.2, marginBottom: '12px' }}>Корзина</h1>
          {count > 0 && <p style={{ fontFamily: font2, fontSize: '16px', color: dark }}>{count} товара на {total}₽</p>}
        </div>

        {items.length === 0 ? (
          <div style={{ ...card, textAlign: 'center', padding: '64px 40px' }}>
            <p style={{ fontFamily: font1, fontSize: '24px', fontWeight: 700, color: dark, marginBottom: '24px' }}>Корзина пуста</p>
            <p style={{ fontFamily: font2, fontSize: '16px', color: '#888', marginBottom: '32px' }}>Добавьте блюда из меню</p>
            <Link href="/menu" style={{ background: 'linear-gradient(135deg, #FF7A1A, #FF4E1A)', color: '#fff', fontFamily: font1, fontWeight: 700, fontSize: '16px', padding: '14px 36px', borderRadius: '50px', textDecoration: 'none', display: 'inline-block', boxShadow: '0 4px 16px rgba(255,90,31,0.35)' }}>Перейти в меню</Link>
          </div>
        ) : (
          <>
            <div style={card}>
              {items.map((item, i) => (
                <div key={item.id} style={{ display: 'flex', alignItems: 'center', gap: '24px', paddingBottom: i < items.length - 1 ? '24px' : '0', marginBottom: i < items.length - 1 ? '24px' : '0', borderBottom: i < items.length - 1 ? '1px solid rgba(255,77,0,0.15)' : 'none' }}>
                  <div style={{ flex: 1 }}>
                    <p style={{ fontFamily: font1, fontWeight: 700, fontSize: '17px', color: dark, marginBottom: '4px' }}>{item.name}</p>
                    <p style={{ fontFamily: font2, fontSize: '15px', color: accent, fontWeight: 700 }}>{item.price}₽</p>
                  </div>
                  <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
                    <button onClick={() => updateQty(item.id, item.quantity - 1)} style={{ width: '36px', height: '36px', borderRadius: '50%', border: '2px solid #FF4D00', background: 'none', color: '#FF4D00', fontSize: '20px', cursor: 'pointer', fontWeight: 700, display: 'flex', alignItems: 'center', justifyContent: 'center' }}>-</button>
                    <span style={{ fontFamily: font1, fontWeight: 700, fontSize: '18px', color: dark, minWidth: '24px', textAlign: 'center' }}>{item.quantity}</span>
                    <button onClick={() => updateQty(item.id, item.quantity + 1)} style={{ width: '36px', height: '36px', borderRadius: '50%', border: '2px solid #FF4D00', background: 'none', color: '#FF4D00', fontSize: '20px', cursor: 'pointer', fontWeight: 700, display: 'flex', alignItems: 'center', justifyContent: 'center' }}>+</button>
                  </div>
                  <p style={{ fontFamily: font1, fontWeight: 700, fontSize: '17px', color: dark, minWidth: '80px', textAlign: 'right' }}>{item.price * item.quantity}₽</p>
                  <button onClick={() => removeItem(item.id)} style={{ background: 'none', border: 'none', cursor: 'pointer', color: '#ccc', fontSize: '22px', fontWeight: 700, padding: '0 4px' }}>x</button>
                </div>
              ))}
            </div>

            <div style={{ ...card, display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: '24px' }}>
              <div>
                <p style={{ fontFamily: font2, fontSize: '15px', color: '#888', marginBottom: '4px' }}>Итого</p>
                <p style={{ fontFamily: font1, fontSize: '32px', fontWeight: 900, color: dark }}>{total}₽</p>
              </div>
              <div style={{ display: 'flex', gap: '16px', flexWrap: 'wrap' }}>
                <button onClick={clearCart} style={{ background: 'none', border: '2px solid #FF4D00', color: '#FF4D00', fontFamily: font1, fontWeight: 700, fontSize: '15px', padding: '12px 28px', borderRadius: '50px', cursor: 'pointer' }}>Очистить</button>
                <Link href="/payment" style={{ background: 'linear-gradient(135deg, #FF7A1A, #FF4E1A)', color: '#fff', fontFamily: font1, fontWeight: 700, fontSize: '16px', padding: '14px 36px', borderRadius: '50px', textDecoration: 'none', display: 'inline-block', boxShadow: '0 4px 16px rgba(255,90,31,0.35)' }}>Оформить заказ</Link>
              </div>
            </div>
          </>
        )}
      </div>
    </main>
  )
}
