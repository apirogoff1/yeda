  { src: '/photo_yeda/brushes/stroke-blue.png', top: 90, left: 238, w: 600, rotate: 0 },
  { src: '/photo_yeda/brushes/stroke-blue.png', top: 400, left: -80, w: 600, rotate: 10 },
]
const pageDekor_drops = [
  { src: '/photo_yeda/brushes/drop-blue.png', top: 299, left: 811, w: 400, rotate: 0 },
]
const pageDekor_veggies = [
  { src: '/photo_yeda/vegetables/broccoli.png', top: 80, left: 20, w: 280, rotate: -15 },
]
const pageDekor_dishes = [
  { src: '/photo_yeda/illustrations/shawarma_1-Photoroom.png', top: 251, left: 151, w: 320, rotate: 5 },
]

﻿import FloatingShapes from '@/components/home/FloatingShapes'

export const dynamic = 'force-dynamic'

export default function DeliveryPage() {
  return (
    <main style={{ minHeight: '2200px', paddingTop: '120px', paddingBottom: '80px', position: 'relative', overflow: 'hidden' }}>

      <FloatingShapes />

      {/* Декор */}
      <img src="/photo_yeda/brushes/stroke-blue.png" alt="" style={{ position: 'absolute', top: '-60px', right: '-80px', width: '500px', opacity: 0.6, pointerEvents: 'none', zIndex: 0 }} />
      <img src="/photo_yeda/brushes/stroke-blue.png" alt="" style={{ position: 'absolute', bottom: '300px', left: '-100px', width: '400px', opacity: 0.4, pointerEvents: 'none', zIndex: 0, transform: 'scaleX(-1) rotate(15deg)' }} />
      <img src="/photo_yeda/brushes/drop-blue.png" alt="" style={{ position: 'absolute', top: '200px', right: '40px', width: '100px', opacity: 0.5, pointerEvents: 'none', zIndex: 0 }} />
      <img src="/photo_yeda/brushes/drop-blue.png" alt="" style={{ position: 'absolute', bottom: '400px', left: '40px', width: '80px', opacity: 0.4, pointerEvents: 'none', zIndex: 0, transform: 'rotate(40deg)' }} />
      <img src="/photo_yeda/vegetables/broccoli.png" alt="" style={{ position: 'absolute', top: '120px', left: '4%', width: '100px', opacity: 0.85, pointerEvents: 'none', zIndex: 0, transform: 'rotate(-15deg)' }} />
      <img src="/photo_yeda/illustrations/shawarma_1-Photoroom.png" alt="" style={{ position: 'absolute', bottom: '80px', right: '4%', width: '150px', opacity: 0.9, pointerEvents: 'none', zIndex: 0, transform: 'rotate(5deg)' }} />

      <div style={{ position: 'relative', zIndex: 2, maxWidth: '780px', margin: '0 auto', padding: '0 24px' }}>

        {/* Заголовок */}
        {/* BLOCK:del-header */}
        <div style={{ position: 'absolute', top: 72, left: 333, width: 780, zIndex: 2, textAlign: 'center' }}>
          <h1 style={{ fontFamily: 'var(--font-comfortaa)', fontSize: '48px', fontWeight: 900, color: '#4A90D9', lineHeight: 1.2, marginBottom: '16px' }}>
            Горячая еда — прямо к вашей двери
          </h1>
          <p style={{ fontFamily: 'var(--font-geologica)', fontSize: '18px', color: '#6B5C53', lineHeight: 1.7, maxWidth: '600px', margin: '0 auto 32px' }}>
            Готовим после заказа и стараемся доставить его в течение 30–60 минут.
          </p>
          <a href="/menu" style={{ background: '#4A90D9', color: '#fff', fontFamily: 'var(--font-comfortaa)', fontWeight: 700, fontSize: '16px', padding: '14px 36px', borderRadius: '50px', textDecoration: 'none' }}>Проверить адрес</a>
        </div>

        {/* Зона доставки */}
        {/* BLOCK:del-zone */}
        <div style={{ position: 'absolute', top: 420, left: 250, width: 780, zIndex: 2, background: 'rgba(255,255,255,0.65)', borderRadius: '32px', padding: '40px', backdropFilter: 'blur(8px)' }}>
          <h2 style={{ fontFamily: 'var(--font-comfortaa)', fontSize: '28px', fontWeight: 900, color: '#433932', marginBottom: '12px' }}>Доставляем туда, где вы находитесь</h2>
          <p style={{ fontFamily: 'var(--font-geologica)', fontSize: '16px', color: '#6B5C53', marginBottom: '24px' }}>Введите адрес — система автоматически проверит, входит ли он в зону доставки.</p>
          <div style={{ display: 'flex', gap: '12px', flexWrap: 'wrap' }}>
            <input placeholder="Введите улицу, дом и квартиру" style={{ flex: 1, minWidth: '240px', padding: '14px 20px', borderRadius: '50px', border: '2px solid #4A90D9', fontFamily: 'var(--font-geologica)', fontSize: '15px', outline: 'none', background: '#fff' }} />
            <button style={{ background: '#4A90D9', color: '#fff', fontFamily: 'var(--font-comfortaa)', fontWeight: 700, fontSize: '15px', padding: '14px 28px', borderRadius: '50px', border: 'none', cursor: 'pointer' }}>Проверить доставку</button>
          </div>
        </div>

        {/* Стоимость */}
        {/* BLOCK:del-price */}
        <div style={{ position: 'absolute', top: 720, left: 250, width: 780, zIndex: 2, background: 'rgba(255,255,255,0.65)', borderRadius: '32px', padding: '40px', backdropFilter: 'blur(8px)' }}>
          <h2 style={{ fontFamily: 'var(--font-comfortaa)', fontSize: '28px', fontWeight: 900, color: '#433932', marginBottom: '12px' }}>Сколько стоит доставка?</h2>
          <p style={{ fontFamily: 'var(--font-geologica)', fontSize: '16px', color: '#6B5C53', marginBottom: '16px' }}>Базовая стоимость уточняется при оформлении. Точная цена показывается до оплаты — никаких сюрпризов после оформления.</p>
          <div style={{ background: 'rgba(74,144,217,0.08)', borderRadius: '20px', padding: '20px 24px' }}>
            <p style={{ fontFamily: 'var(--font-comfortaa)', fontSize: '16px', fontWeight: 700, color: '#4A90D9', margin: 0 }}>До бесплатной доставки осталось 350 ₽. Добавим что-нибудь вкусное?</p>
          </div>
        </div>

        {/* Время */}
        {/* BLOCK:del-time */}
        <div style={{ position: 'absolute', top: 1020, left: 250, width: 780, zIndex: 2, background: 'rgba(255,255,255,0.65)', borderRadius: '32px', padding: '40px', backdropFilter: 'blur(8px)' }}>
          <h2 style={{ fontFamily: 'var(--font-comfortaa)', fontSize: '28px', fontWeight: 900, color: '#433932', marginBottom: '12px' }}>Обычно — через 30–60 минут</h2>
          <p style={{ fontFamily: 'var(--font-geologica)', fontSize: '16px', color: '#6B5C53', marginBottom: '24px' }}>Время зависит от адреса, загрузки кухни и дорожной ситуации.</p>
          <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
            {['Заказ принят', 'Готовим', 'Упаковываем', 'Курьер уже едет', 'Заказ у двери'].map((status, i) => (
              <div key={i} style={{ display: 'flex', alignItems: 'center', gap: '16px' }}>
                <div style={{ minWidth: '32px', height: '32px', borderRadius: '50%', background: '#4A90D9', display: 'flex', alignItems: 'center', justifyContent: 'center', color: '#fff', fontFamily: 'var(--font-comfortaa)', fontWeight: 700, fontSize: '14px' }}>{i + 1}</div>
                <span style={{ fontFamily: 'var(--font-geologica)', fontSize: '16px', color: '#433932' }}>{status}</span>
              </div>
            ))}
          </div>
        </div>

        {/* Опоздание */}
        {/* BLOCK:del-late */}
        <div style={{ position: 'absolute', top: 1380, left: 250, width: 780, zIndex: 2, background: 'rgba(255,255,255,0.65)', borderRadius: '32px', padding: '40px', backdropFilter: 'blur(8px)' }}>
          <h2 style={{ fontFamily: 'var(--font-comfortaa)', fontSize: '28px', fontWeight: 900, color: '#433932', marginBottom: '12px' }}>Что делать, если курьер опаздывает?</h2>
          <p style={{ fontFamily: 'var(--font-geologica)', fontSize: '16px', color: '#6B5C53', marginBottom: '16px' }}>Мы понимаем: когда ждёшь еду, каждая минута кажется длиннее.</p>
          <div style={{ display: 'flex', flexDirection: 'column', gap: '10px', marginBottom: '24px' }}>
            {['Проверьте статус в личном кабинете', 'Если задержка существенная — напишите нам', 'Поддержка поможет разобраться с ситуацией'].map((t, i) => (
              <div key={i} style={{ display: 'flex', gap: '12px', alignItems: 'flex-start' }}>
                <span style={{ color: '#4A90D9', fontWeight: 700, fontFamily: 'var(--font-comfortaa)' }}>{i + 1}.</span>
                <span style={{ fontFamily: 'var(--font-geologica)', fontSize: '15px', color: '#6B5C53' }}>{t}</span>
              </div>
            ))}
          </div>
          <a href="/contacts" style={{ background: '#4A90D9', color: '#fff', fontFamily: 'var(--font-comfortaa)', fontWeight: 700, fontSize: '15px', padding: '12px 28px', borderRadius: '50px', textDecoration: 'none' }}>Связаться с поддержкой</a>
        </div>

        {/* CTA */}
        {/* BLOCK:del-cta */}
        <div style={{ position: 'absolute', top: 1760, left: 250, width: 780, zIndex: 2, textAlign: 'center' }}>
          <h2 style={{ fontFamily: 'var(--font-comfortaa)', fontSize: '28px', fontWeight: 900, color: '#433932', marginBottom: '24px' }}>А куда сегодня доставить вкусное?</h2>
          <div style={{ display: 'flex', gap: '12px', justifyContent: 'center', flexWrap: 'wrap' }}>
            <input placeholder="Введите адрес доставки" style={{ minWidth: '280px', padding: '14px 20px', borderRadius: '50px', border: '2px solid #4A90D9', fontFamily: 'var(--font-geologica)', fontSize: '15px', outline: 'none', background: '#fff' }} />
            <a href="/menu" style={{ background: '#4A90D9', color: '#fff', fontFamily: 'var(--font-comfortaa)', fontWeight: 700, fontSize: '16px', padding: '14px 36px', borderRadius: '50px', textDecoration: 'none' }}>Заказать</a>
          </div>
        </div>

      </div>
    </main>
  )
