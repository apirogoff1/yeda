'use client'
import Link from 'next/link'
import { useState } from 'react'
import FloatingShapes from '@/components/home/FloatingShapes'

export default function DeliveryPage() {
  const [address, setAddress] = useState('')
  const [checked, setChecked] = useState<null | boolean>(null)
  const [email, setEmail] = useState('')
  const [notified, setNotified] = useState(false)
  const accent = '#4A90D9'
  const dark = '#433932'
  const muted = '#3D2E28'
  const font1 = 'var(--font-comfortaa)'
  const font2 = 'var(--font-geologica)'

  return (
    <>
      <style>{`
        .delivery-main {
          min-height: 100vh;
          padding-top: 120px;
          padding-bottom: 80px;
          position: relative;
          overflow: hidden;
        }
        .delivery-inner {
          position: relative;
          z-index: 2;
          max-width: 780px;
          margin: 0 auto;
          padding: 0 24px;
        }
        .delivery-card {
          background: rgba(255,255,255,0.65);
          border-radius: 32px;
          padding: 40px;
          backdrop-filter: blur(8px);
          margin-bottom: 32px;
        }
        .delivery-h1 {
          font-family: var(--font-comfortaa);
          font-size: 48px;
          font-weight: 900;
          color: #4A90D9;
          line-height: 1.2;
          margin-bottom: 16px;
        }
        .delivery-h2 {
          font-family: var(--font-comfortaa);
          font-size: 28px;
          font-weight: 900;
          color: #433932;
          margin-bottom: 12px;
        }
        .delivery-p {
          font-family: var(--font-geologica);
          font-size: 16px;
          color: #3D2E28;
          line-height: 1.7;
        }
        .delivery-btn {
          background: #4A90D9;
          color: #fff;
          font-family: var(--font-comfortaa);
          font-weight: 700;
          font-size: 16px;
          padding: 14px 36px;
          border-radius: 50px;
          border: none;
          cursor: pointer;
          text-decoration: none;
          display: inline-block;
          white-space: nowrap;
        }
        .delivery-input {
          width: 100%;
          box-sizing: border-box;
          padding: 14px 20px;
          border-radius: 50px;
          border: 2px solid #4A90D9;
          font-family: var(--font-geologica);
          font-size: 15px;
          outline: none;
          background: #fff;
        }
        .delivery-input-group {
          display: flex;
          flex-direction: row;
          gap: 12px;
          align-items: center;
          margin-bottom: 16px;
        }
        .delivery-steps {
          display: flex;
          flex-direction: column;
          gap: 12px;
        }
        .delivery-step {
          display: flex;
          align-items: center;
          gap: 16px;
        }
        .delivery-step-num {
          min-width: 36px;
          height: 36px;
          border-radius: 50%;
          background: #4A90D9;
          display: flex;
          align-items: center;
          justify-content: center;
          color: #fff;
          font-family: var(--font-comfortaa);
          font-weight: 700;
          font-size: 14px;
        }
        .delivery-hero {
          text-align: center;
          margin-bottom: 64px;
        }
        .delivery-cta {
          text-align: center;
          padding-top: 16px;
        }
        .delivery-hint {
          background: rgba(74,144,217,0.08);
          border-radius: 20px;
          padding: 20px 24px;
        }
        @media (max-width: 768px) {
          .delivery-main { padding-top: 80px; padding-bottom: 60px; }
          .delivery-inner { padding: 0 16px; }
          .delivery-card { padding: 24px 20px; border-radius: 24px; margin-bottom: 20px; }
          .delivery-h1 { font-size: 28px; }
          .delivery-h2 { font-size: 22px; }
          .delivery-p { font-size: 15px; }
          .delivery-input { font-size: 14px; padding: 13px 16px; }
          .delivery-input-group { flex-direction: column; align-items: flex-start; }
          .delivery-hero { margin-bottom: 32px; }
          .delivery-step-num { min-width: 32px; height: 32px; font-size: 13px; }
        }
      `}</style>

      <main className="delivery-main">
        <FloatingShapes />
        <img src="/photo_yeda/brushes/brush-blue.png" alt="" style={{ position: 'absolute', top: '0px', left: '-80px', width: '1200px', opacity: 0.45, pointerEvents: 'none', zIndex: 0, transform: 'rotate(25deg)', filter: 'blur(1.5px)' }} />
        <img src="/photo_yeda/brushes/brush-blue.png" alt="" style={{ position: 'absolute', top: '800px', right: '-450px', width: '1300px', opacity: 0.45, pointerEvents: 'none', zIndex: 0, transform: 'rotate(100deg)', filter: 'blur(1.5px)' }} />
        <img src="/photo_yeda/brushes/brush-blue.png" alt="" style={{ position: 'absolute', top: '1600px', left: '-350px', width: '1250px', opacity: 0.45, pointerEvents: 'none', zIndex: 0, transform: 'rotate(-30deg)', filter: 'blur(1.5px)' }} />
        <img src="/photo_yeda/brushes/drop-blue.png" alt="" style={{ position: 'absolute', top: '200px', right: '-20px', width: '800px', opacity: 0.45, pointerEvents: 'none', zIndex: 0, transform: 'rotate(30deg)', filter: 'blur(1.5px)' }} />
        <img src="/photo_yeda/brushes/drop-blue.png" alt="" style={{ position: 'absolute', top: '1000px', left: '-20px', width: '800px', opacity: 0.45, pointerEvents: 'none', zIndex: 0, transform: 'rotate(-120deg)', filter: 'blur(1.5px)' }} />
        <img src="/photo_yeda/brushes/drop-blue.png" alt="" style={{ position: 'absolute', top: '1900px', right: '-20px', width: '800px', opacity: 0.45, pointerEvents: 'none', zIndex: 0, transform: 'rotate(20deg)', filter: 'blur(1.5px)' }} />

        <div className="delivery-inner">
          <div className="delivery-hero">
            <h1 className="delivery-h1">Горячая еда — прямо к вашей двери</h1>
            <p className="delivery-p" style={{ maxWidth: '600px', margin: '0 auto 32px' }}>Готовим после заказа и стараемся доставить его в течение 30—60 минут.</p>
            <a href="#zone" className="delivery-btn">Проверить адрес</a>
          </div>

          <div id="zone" className="delivery-card">
            <h2 className="delivery-h2">Доставляем туда, где вы находитесь</h2>
            <p className="delivery-p" style={{ marginBottom: '24px' }}>Введите адрес — система автоматически проверит, входит ли он в зону доставки.</p>
            <div className="delivery-input-group">
              <input className="delivery-input" value={address} onChange={e => setAddress(e.target.value)} placeholder="Введите улицу, дом и квартиру" />
              <a onClick={() => setChecked(Math.random() > 0.5)} className="delivery-btn" style={{ cursor: 'pointer' }}>Проверить доставку</a>
            </div>
            {checked === true && <p style={{ fontFamily: font2, fontSize: '15px', color: '#2E7D32', background: 'rgba(46,125,50,0.08)', borderRadius: '16px', padding: '12px 20px' }}>Да! Мы доставляем по этому адресу</p>}
            {checked === false && (
              <div>
                <p className="delivery-p" style={{ marginBottom: '12px' }}>Пока не доставляем сюда, но обязательно хотим расширить зону.</p>
                <div className="delivery-input-group">
                  <input className="delivery-input" value={email} onChange={e => setEmail(e.target.value)} placeholder="Ваш email или телефон" />
                  <button onClick={() => setNotified(true)} className="delivery-btn">Сообщить мне</button>
                </div>
                {notified && <p style={{ fontFamily: font2, fontSize: '14px', color: accent, marginTop: '8px' }}>Отлично! Сообщим, как только появимся рядом.</p>}
              </div>
            )}
          </div>

          <div className="delivery-card">
            <h2 className="delivery-h2">Сколько стоит доставка?</h2>
            <p className="delivery-p" style={{ marginBottom: '16px' }}>Базовая стоимость уточняется при оформлении. Точная цена показывается до оплаты — никаких сюрпризов.</p>
            <div className="delivery-hint">
              <p style={{ fontFamily: font1, fontSize: '16px', fontWeight: 700, color: accent, margin: 0 }}>До бесплатной доставки осталось 350 ₽. Добавим что-нибудь вкусное?</p>
            </div>
          </div>

          <div className="delivery-card">
            <h2 className="delivery-h2">Доставка за наш счёт</h2>
            <p className="delivery-p" style={{ marginBottom: '24px' }}>При заказе от [указать сумму] ₽ доставка бесплатная.</p>
            <Link href="/menu" className="delivery-btn">Добавить блюдо</Link>
          </div>

          <div className="delivery-card">
            <h2 className="delivery-h2">Обычно — через 30—60 минут</h2>
            <p className="delivery-p" style={{ marginBottom: '24px' }}>Время зависит от адреса, загрузки кухни, дорожной ситуации и количества заказов.</p>
            <div className="delivery-steps">
              {['Заказ принят', 'Готовим', 'Упаковываем', 'Курьер уже едет', 'Заказ у двери'].map((status, i) => (
                <div key={i} className="delivery-step">
                  <div className="delivery-step-num">{i + 1}</div>
                  <span style={{ fontFamily: font2, fontSize: '16px', color: dark }}>{status}</span>
                </div>
              ))}
            </div>
          </div>

          <div className="delivery-card">
            <h2 className="delivery-h2">Что делать, если курьер опаздывает?</h2>
            <p className="delivery-p" style={{ fontWeight: 600, marginBottom: '16px' }}>Мы понимаем: когда ждёшь еду, каждая минута кажется длиннее.</p>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '10px', marginBottom: '24px' }}>
              {['Проверьте статус в личном кабинете', 'Если задержка существенная — напишите нам', 'Поддержка поможет разобраться с ситуацией'].map((t, i) => (
                <div key={i} style={{ display: 'flex', gap: '12px', alignItems: 'flex-start' }}>
                  <span style={{ color: accent, fontWeight: 700, fontFamily: font1, minWidth: '20px' }}>{i + 1}.</span>
                  <span style={{ fontFamily: font2, fontSize: '17px', color: muted }}>{t}</span>
                </div>
              ))}
            </div>
            <p className="delivery-p" style={{ fontStyle: 'italic', marginBottom: '24px' }}>Если заказ действительно опоздал по нашей вине, мы предложим подходящий вариант компенсации.</p>
            <Link href="/contacts" className="delivery-btn">Связаться с поддержкой</Link>
          </div>

          <div className="delivery-card">
            <h2 className="delivery-h2">Просто заберите и наслаждайтесь</h2>
            <p className="delivery-p" style={{ marginBottom: '12px' }}>Курьер может передать заказ лично или оставить его у двери.</p>
            <p style={{ fontFamily: font2, fontSize: '14px', color: accent, fontStyle: 'italic' }}>Пожалуйста, убедитесь, что номер телефона в заказе актуален.</p>
          </div>

          <div className="delivery-cta">
            <h2 className="delivery-h2" style={{ marginBottom: '24px' }}>А куда сегодня доставить вкусное?</h2>
            <div className="delivery-input-group" style={{ maxWidth: '600px', margin: '0 auto' }}>
              <input className="delivery-input" placeholder="Введите адрес доставки" />
              <Link href="/menu" className="delivery-btn">Заказать</Link>
            </div>
          </div>

        </div>
      </main>
    </>
  )
}
