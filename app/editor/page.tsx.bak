  { id:"veggie-11",label:"carrot-2",          type:"veggie", src:"/photo_yeda/vegetables/carrot_1.png",      x:84,   y:1662,  w:212, rotate:18  },
  { id:"veggie-12",label:"broccoli-2",        type:"veggie", src:"/photo_yeda/vegetables/broccoli.png",      x:343,  y:2390,  w:215, rotate:-25 },
  { id:"veggie-13",label:"avocado-2",         type:"veggie", src:"/photo_yeda/vegetables/avocado.png",       x:119,  y:2946,  w:300, rotate:15  },
  { id:"veggie-14",label:"tomato-2",          type:"veggie", src:"/photo_yeda/vegetables/tomato.png",        x:850,  y:2097,  w:210, rotate:-20 },
  { id:"veggie-15",label:"pepper-2",          type:"veggie", src:"/photo_yeda/vegetables/pepper.png",        x:614,  y:3025,  w:195, rotate:10  },
  { id:"dish-0", label:"burger",      type:"dish", src:"/photo_yeda/illustrations/burger_illustration_2-Photoroom.png", x:914, y:342,  w:294, rotate:8  },
  { id:"dish-1", label:"pizza",       type:"dish", src:"/photo_yeda/illustrations/pizza_illustration_1-Photoroom.png",  x:1143,y:899,  w:308, rotate:-6 },
  { id:"dish-2", label:"sushi",       type:"dish", src:"/photo_yeda/illustrations/sushi_6.png",                         x:39,  y:771,  w:294, rotate:10 },
  { id:"dish-3", label:"donat",       type:"dish", src:"/photo_yeda/illustrations/donat.png",                           x:240, y:1795, w:304, rotate:12 },
  { id:"dish-4", label:"doner",       type:"dish", src:"/photo_yeda/illustrations/Doner.png",                           x:619, y:2209, w:350, rotate:-10},
  { id:"dish-5", label:"lambchops",   type:"dish", src:"/photo_yeda/illustrations/Lamb chops.png",                      x:1001,y:2570, w:280, rotate:8  },
  { id:"dish-6", label:"shish-kebab", type:"dish", src:"/photo_yeda/illustrations/shish_kebab_2.png",                   x:589, y:1246, w:300, rotate:-8 },
  { id:"block-title",        label:"TITLE",         type:"block", src:"", x:60,  y:92,   w:510, rotate:0 },
  { id:"block-tags",         label:"TAGS",          type:"block", src:"", x:532, y:856,  w:240, rotate:0 },
  { id:"block-btns",         label:"BUTTONS",       type:"block", src:"", x:324, y:709,  w:340, rotate:0 },
  { id:"block-fresh",        label:"Svezhie prod.", type:"block", src:"", x:11,  y:1124, w:380, rotate:0 },
  { id:"block-fresh-tag-1",  label:"Fresh tag",     type:"tag",   src:"", x:58,  y:1304, w:380, rotate:0 },
  { id:"block-delivery",     label:"Dostavka",      type:"block", src:"", x:900, y:1351, w:360, rotate:0 },
  { id:"block-delivery-tag-1",label:"Delivery tag1",type:"tag",   src:"", x:952, y:1459, w:360, rotate:0 },
  { id:"block-delivery-tag-2",label:"Delivery tag2",type:"tag",   src:"", x:935, y:1502, w:360, rotate:0 },
  { id:"block-how",          label:"Kak rabotaet",  type:"block", src:"", x:60,  y:1500, w:380, rotate:0 },
  { id:"block-why",          label:"Pochemu YEDA",  type:"block", src:"", x:629, y:1929, w:380, rotate:0 },
  { id:"block-ai",           label:"AI racion",     type:"block", src:"", x:60,  y:2160, w:420, rotate:0 },
  { id:"block-ai-tag-1",     label:"AI tag",        type:"tag",   src:"", x:60,  y:2220, w:420, rotate:0 },
  { id:"block-ai-btn",       label:"AI btn",        type:"tag",   src:"", x:60,  y:2290, w:420, rotate:0 },
  { id:"block-sub",          label:"Podpiska",      type:"block", src:"", x:605,  y:2427, w:400, rotate:0 },
  { id:"block-sub-input",    label:"Email input",   type:"tag",   src:"", x:605,  y:2567, w:300, rotate:0 },
  { id:"block-sub-btn",      label:"Btn Podpisatsya",type:"tag",  src:"", x:920,  y:2567, w:180, rotate:0 },
  { id:"block-sub-tag-1",    label:"Sub tag",       type:"tag",   src:"", x:619, y:2587, w:400, rotate:0 },
  { id:"block-social",       label:"Kontakty",      type:"block", src:"", x:60,  y:2560, w:360, rotate:0 },
  { id:"block-footer",       label:"Footer",        type:"block", src:"", x:60,  y:2900, w:500, rotate:0 },
];

function generateCode(els: El[]): string {
  const brushes = els.filter(e => e.type === "brush");
  const drops   = els.filter(e => e.type === "drop");
  const veggies = els.filter(e => e.type === "veggie");
  const blocks  = els.filter(e => e.type === "block" || e.type === "tag");

  const bCode = brushes.map(e =>
    `  { src: '${e.src}', top: ${e.y}, left: ${e.x}, w: ${e.w}, rotate: ${e.rotate} },`
  ).join("\n");
  const dCode = drops.map(e =>
    `  { src: '${e.src}', top: ${e.y}, left: ${e.x}, w: ${e.w}, rotate: ${e.rotate} },`
  ).join("\n");
  const vCode = veggies.map(e =>
    `  { src: '${e.src}', top: ${e.y}, left: ${e.x}, w: ${e.w}, rotate: ${e.rotate} },`
  ).join("\n");
  const blCode = blocks.map(e =>
    `  /* ${e.id} */ top: ${e.y}, left: ${e.x}`
  ).join("\n");

  return `// BRUSHES\n[\n${bCode}\n]\n\n// DROPS\n[\n${dCode}\n]\n\n// VEGGIES\n[\n${vCode}\n]\n\n// BLOCKS\n${blCode}`;
}

export default function EditorPage() {
  const [scale, setScale] = useState(1.0);
  const scaleRef = useRef(1.0);

  useEffect(() => {
    const update = () => {
      const s = document.documentElement.clientWidth / CANVAS_W;
      setScale(s);
      scaleRef.current = s;
    };
    update();
    window.addEventListener("resize", update);
    return () => window.removeEventListener("resize", update);
  }, []);

  const [els, setEls] = useState<El[]>(INIT);
  const [selected, setSelected] = useState<string | null>(null);
  const [copied, setCopied] = useState(false);
  const [filter, setFilter] = useState<EType | "all">("all");

  const dragRef = useRef<{ id: string; startX: number; startY: number; origX: number; origY: number } | null>(null);

  const onPointerDown = useCallback((e: React.PointerEvent, id: string) => {
    e.currentTarget.setPointerCapture(e.pointerId);
    e.stopPropagation();
    setEls(prev => {
      const el = prev.find(el => el.id === id)!;
      dragRef.current = { id, startX: e.clientX, startY: e.clientY, origX: el.x, origY: el.y };
      return prev;
    });
    setSelected(id);
  }, []);

  const onPointerMove = useCallback((e: React.PointerEvent) => {
    if (!dragRef.current) return;
    const { id, startX, startY, origX, origY } = dragRef.current;
    const s = scaleRef.current;
    const dx = (e.clientX - startX) / s;
    const dy = (e.clientY - startY) / s;
    setEls(prev => prev.map(el => el.id === id ? { ...el, x: Math.round(origX + dx), y: Math.round(origY + dy) } : el));
  }, []);

  const onPointerUp = useCallback(() => { dragRef.current = null; }, []);

  const handleCopy = async () => {
    const code = generateCode(els);
    navigator.clipboard.writeText(code);
    await fetch("/api/editor-sync", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ elements: els })
    });
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const selectedEl = els.find(e => e.id === selected);
  const visible = filter === "all" ? els : els.filter(e => e.type === filter);

  const typeColor: Record<EType, string> = {
    brush:  "rgba(249,115,22,0.18)",
    drop:   "rgba(59,130,246,0.18)",
    veggie: "rgba(34,197,94,0.18)",
    block:  "rgba(168,85,247,0.18)",
    tag:    "rgba(236,72,153,0.18)",
    dish:   "rgba(239,68,68,0.18)",
  };
  const typeBorder: Record<EType, string> = {
    brush:  "#f97316",
    drop:   "#3b82f6",
    veggie: "#22c55e",
    block:  "#a855f7",
    tag:    "#ec4899",
    dish:   "#ef4444",
  };

  return (
    <div style={{ width: "100%", maxWidth: "100%", minHeight: "100vh", overflowX: "hidden", background: "#111", color: "#fff", display: "flex", flexDirection: "column", fontFamily: "sans-serif", boxSizing: "border-box" }}>

      <div style={{ display: "flex", alignItems: "center", gap: "16px", padding: "10px 20px", background: "#1a1a1a", borderBottom: "1px solid #333", flexWrap: "wrap" }}>
        <span style={{ fontWeight: 700, fontSize: 16 }}>Visual Editor — HeroSection</span>
        <span style={{ fontSize: 12, color: "#888" }}>Masshtab: {Math.round(scale * 100)}%</span>
        {(["all","brush","drop","veggie","block","tag","dish"] as const).map(f => (
          <button key={f} onClick={() => setFilter(f)}
            style={{ padding: "4px 12px", borderRadius: 20, border: "none", cursor: "pointer", fontSize: 12, fontWeight: 600,
              background: filter === f ? "#f97316" : "#333", color: filter === f ? "#fff" : "#aaa" }}>
            {f}
          </button>
        ))}
        <div style={{ marginLeft: "auto", display: "flex", alignItems: "center", gap: 12 }}>
          {selectedEl && (
            <span style={{ fontSize: 12, color: "#aaa" }}>
              <b style={{ color: "#fff" }}>{selectedEl.label}</b> — x: {selectedEl.x} y: {selectedEl.y}
            </span>
          )}
          <button onClick={handleCopy}
            style={{ padding: "6px 18px", borderRadius: 20, border: "none", cursor: "pointer", fontWeight: 700, fontSize: 13,
              background: copied ? "#22c55e" : "#f97316", color: "#fff" }}>
            {copied ? "Skopirovano!" : "Kopirovat koordinaty"}
          </button>
        </div>
      </div>

      <div style={{ flex: 1, overflow: "auto", padding: 0, boxSizing: "border-box", maxWidth: "100%" }}>
        <div
          onPointerMove={onPointerMove}
          onPointerUp={onPointerUp}
          style={{
            position: "relative",
            width: CANVAS_W * scale,
            height: CANVAS_H * scale,
            background: "#F5EAD8",
            borderRadius: 8,
            border: "1px solid #444",
            overflow: "hidden",
            flexShrink: 0,
          }}
        >
          <svg style={{ position: "absolute", inset: 0, pointerEvents: "none" }} width={CANVAS_W * scale} height={CANVAS_H * scale}>
            <defs>
              <pattern id="g" width={40 * scale} height={40 * scale} patternUnits="userSpaceOnUse">
                <path d={`M ${40 * scale} 0 L 0 0 0 ${40 * scale}`} fill="none" stroke="rgba(0,0,0,0.08)" strokeWidth="1"/>
              </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#g)"/>
          </svg>

          {visible.map(el => {
            const isBlock = el.type === "block" || el.type === "tag";
            const isSelected = selected === el.id;
            return (
              <div
                key={el.id}
                onPointerDown={e => onPointerDown(e, el.id)}
                style={{
                  position: "absolute",
                  left: el.x * scale,
                  top: el.y * scale,
                  width: el.w * scale,
                  height: isBlock ? 60 * scale : el.w * scale,
                  cursor: "grab",
                  userSelect: "none",
                  touchAction: "none",
                  zIndex: isSelected ? 100 : isBlock ? 10 : el.type === "veggie" ? 3 : el.type === "drop" ? 2 : 1,
                  outline: isSelected ? "2px solid #fff" : `1.5px solid ${typeBorder[el.type]}`,
                  borderRadius: 4,
                  overflow: "visible",
                }}
              >
                {el.src ? (
                  <img
                    src={el.src}
                    alt={el.label}
                    style={{
                      width: "100%",
                      height: "100%",
                      objectFit: "contain",
                      transform: `rotate(${el.rotate}deg)`,
                      opacity: el.type === "brush" ? 0.6 : 1,
                      display: "block",
                      pointerEvents: "none",
                    }}
                  />
                ) : (
                  <div style={{
                    width: "100%", height: "100%",
                    background: typeColor[el.type],
                    display: "flex", alignItems: "center", justifyContent: "center",
                    fontSize: 10, fontWeight: 700, color: typeBorder[el.type],
                    borderRadius: 4,
                  }}>
                    {el.label}
                  </div>
                )}
                <div style={{
                  position: "absolute", top: -18, left: 0,
                  fontSize: 9, color: typeBorder[el.type], fontWeight: 700,
                  whiteSpace: "nowrap", pointerEvents: "none",
                  background: "rgba(0,0,0,0.5)", padding: "1px 4px", borderRadius: 3,
                }}>
                  {el.label}
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <div style={{ padding: "12px 20px", background: "#1a1a1a", borderTop: "1px solid #333", maxHeight: 180, overflow: "auto" }}>
        <p style={{ fontSize: 11, color: "#555", marginBottom: 6 }}>Koordinaty (gotovy dlya vstavki v HeroSection.tsx):</p>
        <pre style={{ fontSize: 11, color: "#4ade80", fontFamily: "monospace", whiteSpace: "pre-wrap", margin: 0 }}>
          {generateCode(els)}
        </pre>
      </div>
    </div>
  );
}
