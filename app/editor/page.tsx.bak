  { id:"brush-8",  label:"brush-skyblue-2",   type:"brush",  src:"/photo_yeda/brushes/brush-skyblue.png",    x:-60,  y:2440,  w:880, rotate:215 },
  { id:"brush-9",  label:"brush-zucchini-2",  type:"brush",  src:"/photo_yeda/brushes/brush-zucchini.png",   x:860,  y:2780,  w:860, rotate:42  },
  { id:"brush-10", label:"brush-raspberry-2", type:"brush",  src:"/photo_yeda/brushes/brush-raspberry.png",  x:-40,  y:3000,  w:880, rotate:-18 },
  { id:"drop-0",   label:"drop-pink",         type:"drop",   src:"/photo_yeda/brushes/drop-pink.png",        x:631,  y:625,   w:580, rotate:-30 },
  { id:"drop-1",   label:"drop-blue",         type:"drop",   src:"/photo_yeda/brushes/drop-blue.png",        x:992,  y:806,   w:560, rotate:50  },
  { id:"drop-2",   label:"drop-zucchini",     type:"drop",   src:"/photo_yeda/brushes/brush-zucchini.png",   x:58,   y:1254,  w:860, rotate:-150},
  { id:"veggie-0", label:"carrot",            type:"veggie", src:"/photo_yeda/vegetables/carrot_1.png",      x:926,  y:1512,  w:218, rotate:25  },
  { id:"veggie-1", label:"zucchini",          type:"veggie", src:"/photo_yeda/vegetables/zucchini_1.png",    x:1273, y:675,   w:230, rotate:-15 },
  { id:"veggie-2", label:"zucchini-2",        type:"veggie", src:"/photo_yeda/vegetables/zucchini_1.png",    x:668,  y:2749,  w:230, rotate:20  },
  { id:"veggie-3", label:"broccoli",          type:"veggie", src:"/photo_yeda/vegetables/broccoli.png",      x:356,  y:504,   w:220, rotate:-63 },
  { id:"veggie-4", label:"avocado",           type:"veggie", src:"/photo_yeda/vegetables/avocado.png",       x:441,  y:943,   w:300, rotate:-30 },
  { id:"veggie-5", label:"strawberry",        type:"veggie", src:"/photo_yeda/vegetables/strawberry.png",    x:896,  y:932,   w:185, rotate:12  },
  { id:"veggie-6", label:"strawberry-2",      type:"veggie", src:"/photo_yeda/vegetables/strawberry.png",    x:1249, y:1816,  w:185, rotate:-15 },
  { id:"veggie-7", label:"tomato",            type:"veggie", src:"/photo_yeda/vegetables/tomato.png",        x:40,   y:1380,  w:210, rotate:-18 },
  { id:"veggie-8", label:"pepper",            type:"veggie", src:"/photo_yeda/vegetables/pepper.png",        x:332,  y:766,   w:300, rotate:22  },
