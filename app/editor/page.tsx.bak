"use client";
import { useRef, useState, useCallback, useEffect } from "react";

const CANVAS_W = 1280;
const CANVAS_H = 3200;

type EType = "brush" | "drop" | "veggie" | "block" | "tag" | "dish";

interface El {
  id: string;
  label: string;
  src: string;
  x: number;
  y: number;
  w: number;
  rotate: number;
  type: EType;
}

const INIT: El[] = [
  { id:"brush-0",  label:"brush-carrot",      type:"brush",  src:"/photo_yeda/brushes/brush-carrot.png",     x:324,  y:-204,  w:900, rotate:-30 },
  { id:"brush-1",  label:"brush-skyblue",     type:"brush",  src:"/photo_yeda/brushes/brush-skyblue.png",    x:338,  y:914,   w:880, rotate:-15 },
  { id:"brush-2",  label:"brush-blue",        type:"brush",  src:"/photo_yeda/brushes/brush-blue.png",       x:920,  y:80,    w:820, rotate:90  },
  { id:"brush-3",  label:"brush-zucchini",    type:"brush",  src:"/photo_yeda/brushes/brush-zucchini.png",   x:-219, y:490,   w:860, rotate:-102},
  { id:"brush-4",  label:"brush-strawberry",  type:"brush",  src:"/photo_yeda/brushes/brush-strawberry.png", x:845,  y:1039,  w:880, rotate:125 },
