'use client';

import { useState } from 'react';
import FloatingShapes from '@/components/home/FloatingShapes';
import SupportModal from '@/components/SupportModal';

const faqs = [
  { id: 1, q: 'Как быстро доставляется заказ?', a: 'Ориентировочное время доставки — 30–60 минут. Точное время зависит от адреса, загрузки кухни и дорожной ситуации. Актуальный прогноз показываем при оформлении заказа.' },
  { id: 2, q: 'Как узнать, доставляете ли вы по моему адресу?', a: 'Введите адрес в корзине или на странице доставки. Система автоматически проверит доступность доставки.' },
  { id: 3, q: 'Сколько стоит доставка?', a: 'Стоимость зависит от условий заказа и адреса. Точная сумма отображается перед оплатой.' },
  { id: 4, q: 'Есть ли бесплатная доставка?', a: 'Да. При заказе от определённой суммы доставка бесплатная. Актуальные условия отображаются в корзине.' },
  { id: 5, q: 'Можно ли изменить заказ после оформления?', a: 'Если кухня ещё не начала приготовление, мы постараемся внести изменения. Свяжитесь с поддержкой как можно скорее.', btn: true },
  { id: 6, q: 'Можно ли отменить заказ?', a: 'Да, если заказ ещё не перешёл в стадию приготовления. Возможность отмены зависит от статуса заказа.' },
  { id: 7, q: 'Как оплатить заказ?', a: 'Доступные способы оплаты отображаются во время оформления. Выберите удобный вариант и подтвердите заказ.' },
  { id: 8, q: 'Можно ли заказать еду на конкретное время?', a: 'Если функция доступна для вашего адреса, при оформлении появится возможность выбрать время доставки.' },
  { id: 9, q: 'Где посмотреть состав блюда?', a: 'Откройте карточку блюда — там указаны ингредиенты, вес, теги и другая доступная информация.' },
  { id: 10, q: 'Есть ли в меню вегетарианские блюда?', a: 'Да. Такие позиции отмечены тегом «Вегетарианское». Также можно использовать фильтры меню.' },
  { id: 11, q: 'Можно ли попросить убрать ингредиент?', a: 'Для некоторых блюд возможны изменения состава. Если опция доступна, она будет показана в карточке блюда или при оформлении.' },
  { id: 12, q: 'Что делать, если блюдо приехало повреждённым?', a: 'Напишите в поддержку и приложите фото заказа. Мы разберёмся в ситуации и предложим решение.', btn: true },
  { id: 13, q: 'Что такое YEDA AI?', a: 'Это AI-помощник, который помогает подобрать еду на основе ваших предпочтений. Например: «Хочу лёгкий ужин без мяса» или «Подбери обед до 800 рублей на двоих».' },
  { id: 14, q: 'Как работает подписка?', a: 'Вы выбираете тариф, настраиваете предпочтения и получаете регулярные заказы и бонусы.', sub: true },
];

export default function FaqPage() {
  const [open, setOpen] = useState<number | null>(null);
  const [search, setSearch] = useState('');
  const [modal, setModal] = useState(false);

  const filtered = faqs.filter(f =>
    f.q.toLowerCase().includes(search.toLowerCase()) ||
    f.a.toLowerCase().includes(search.toLowerCase())
  );

  return (
    <main style={{ paddingTop: '120px', paddingBottom: '40px' }}>
      {modal && <SupportModal onClose={() => setModal(false)} />}
      <div style={{ maxWidth: '760px', margin: '0 auto', padding: '0 24px', position: 'relative', zIndex: 1 }}>

        <div style={{ textAlign: 'center', marginBottom: '48px' }}>
          <div style={{ display: 'inline-block', background: 'rgba(232,68,106,0.1)', borderRadius: '100px', padding: '8px 20px', marginBottom: '20px' }}>
            <span style={{ color: '#E8446A', fontFamily: 'var(--font-geologica)', fontSize: '14px', fontWeight: 600 }}>Частые вопросы</span>
          </div>
          <h1 style={{ fontFamily: 'var(--font-comfortaa)', fontSize: '42px', fontWeight: 700, color: '#433932', marginBottom: '16px', lineHeight: 1.2 }}>Вопросы? У нас есть ответы</h1>
          <p style={{ fontFamily: 'var(--font-geologica)', fontSize: '17px', color: '#3D2E28', maxWidth: '520px', margin: '0 auto 32px' }}>Собрали всё самое важное. А если не нашли нужного — просто напишите нам.</p>
          <input
            type="text"
            placeholder="Например: «Как оплатить заказ?»"
            value={search}
            onChange={e => setSearch(e.target.value)}
            style={{ width: '100%', padding: '14px 20px', borderRadius: '16px', border: '2px solid rgba(232,68,106,0.2)', background: 'rgba(255,255,255,0.8)', fontFamily: 'var(--font-geologica)', fontSize: '16px', color: '#433932', outline: 'none', boxSizing: 'border-box' }}
          />
        </div>

        <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
          {filtered.map(item => (
            <div key={item.id} style={{ background: 'rgba(255,255,255,0.65)', borderRadius: '24px', backdropFilter: 'blur(8px)', overflow: 'hidden', border: open === item.id ? '2px solid rgba(232,68,106,0.3)' : '2px solid transparent', transition: 'border 0.2s' }}>
              <button
                onClick={() => setOpen(open === item.id ? null : item.id)}
                style={{ width: '100%', display: 'flex', justifyContent: 'space-between', alignItems: 'center', padding: '20px 24px', background: 'none', border: 'none', cursor: 'pointer', textAlign: 'left', gap: '16px' }}
              >
                <span style={{ fontFamily: 'var(--font-geologica)', fontSize: '17px', fontWeight: 600, color: '#433932' }}>{item.q}</span>
                <span style={{ color: '#E8446A', fontSize: '22px', lineHeight: 1, flexShrink: 0, transform: open === item.id ? 'rotate(45deg)' : 'rotate(0deg)', transition: 'transform 0.2s' }}>+</span>
              </button>
              {open === item.id && (
                <div style={{ padding: '0 24px 20px' }}>
                  <p style={{ fontFamily: 'var(--font-geologica)', fontSize: '16px', color: '#3D2E28', lineHeight: 1.6, margin: 0 }}>{item.a}</p>
                  {item.btn && (
                    <button onClick={() => setModal(true)} style={{ marginTop: '16px', padding: '10px 24px', background: '#E8446A', color: '#fff', border: 'none', borderRadius: '100px', fontFamily: 'var(--font-geologica)', fontSize: '15px', fontWeight: 600, cursor: 'pointer' }}>Написать в поддержку</button>
                  )}
                  {item.sub && (
                    <button onClick={() => window.location.href = '/subscription'} style={{ marginTop: '16px', padding: '10px 24px', background: '#E8446A', color: '#fff', border: 'none', borderRadius: '100px', fontFamily: 'var(--font-geologica)', fontSize: '15px', fontWeight: 600, cursor: 'pointer' }}>Посмотреть подписку</button>
                  )}
                </div>
              )}
            </div>
          ))}
        </div>

        <div style={{ marginTop: '64px', textAlign: 'center', background: 'rgba(255,255,255,0.65)', borderRadius: '32px', padding: '40px', backdropFilter: 'blur(8px)' }}>
          <p style={{ fontFamily: 'var(--font-comfortaa)', fontSize: '22px', fontWeight: 700, color: '#433932', marginBottom: '8px' }}>Не нашли ответ?</p>
          <p style={{ fontFamily: 'var(--font-geologica)', fontSize: '16px', color: '#3D2E28', marginBottom: '24px' }}>Напишите нам — мы ответим быстро</p>
          <button onClick={() => setModal(true)} style={{ padding: '14px 32px', background: '#E8446A', color: '#fff', border: 'none', borderRadius: '100px', fontFamily: 'var(--font-geologica)', fontSize: '16px', fontWeight: 600, cursor: 'pointer' }}>Написать в поддержку</button>
        </div>

      </div>
    </main>
  );
}




