@tailwind base;
html, body { margin: 0; padding: 0; overflow-x: hidden; box-sizing: border-box; }
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: #FFE4E8;
    --foreground: #171717;
    --card: #FFFFFF;
    --card-foreground: oklch(0.1 0 0);
    --popover: oklch(1 0 0);
    --popover-foreground: oklch(0.1 0 0);
    --primary: #E85D3F;
    --primary-foreground: oklch(0.985 0 0);
    --secondary: #EFEAE2;
    --secondary-foreground: oklch(0.205 0 0);
    --muted: oklch(0.97 0 0);
    --muted-foreground: oklch(0.4 0 0);
    --accent: oklch(0.97 0 0);
    --accent-foreground: oklch(0.205 0 0);
    --destructive: oklch(0.577 0.245 27.325);
    --border: oklch(0.922 0 0);
    --input: oklch(0.922 0 0);
    --ring: oklch(0.708 0 0);
    --radius: 0.625rem;
  }
  .dark {
    --background: oklch(0.145 0 0);
    --foreground: oklch(0.985 0 0);
    --card: oklch(0.205 0 0);
    --card-foreground: oklch(0.985 0 0);
    --popover: oklch(0.205 0 0);
    --popover-foreground: oklch(0.985 0 0);
    --primary: oklch(0.922 0 0);
    --primary-foreground: oklch(0.205 0 0);
    --secondary: oklch(0.269 0 0);
    --secondary-foreground: oklch(0.985 0 0);
    --muted: oklch(0.269 0 0);
    --muted-foreground: oklch(0.708 0 0);
    --accent: oklch(0.269 0 0);
    --accent-foreground: oklch(0.985 0 0);
    --destructive: oklch(0.704 0.191 22.216);
    --border: oklch(1 0 0 / 10%);
    --input: oklch(1 0 0 / 15%);
    --ring: oklch(0.556 0 0);
  }
  * {
    border-color: var(--border);
  }
  body {
    background-color: var(--background);
    color: var(--foreground);
  }
}

/* Улучшенная читаемость текста */
p, li, span, div {
  color: inherit;
}
.text-gray-500 { color: #1e3a5f !important; font-weight: 400; }
.text-gray-600 { color: #1e3a5f !important; font-weight: 400; }
.text-gray-700 { color: #1e3a5f !important; font-weight: 400; }

@keyframes pulse-bright {
  0%, 100% { filter: brightness(1); }
  50% { filter: brightness(1.4); }
}
.nav-pulse {
  animation: pulse-bright 2s ease-in-out infinite;
}
input::placeholder { color: #9B111E; font-weight: 800; opacity: 1; }

.max-tooltip-wrap:hover .max-tooltip { opacity: 1 !important; }

/* BURGER BANNER */
.burger-mobile-photo { display: none; }
.burger-banner {
  position: relative;
  display: grid;
  grid-template-columns: 1fr;
  width: min(1520px, calc(100vw - 48px));
  min-height: 520px;
  margin: 0 auto;
  background: rgba(255,247,238,0.78);
  box-shadow: 0 4px 32px rgba(0,0,0,0.08);
  border-radius: 32px;
  overflow: hidden;
  isolation: isolate;
}


.burger-visual img {
  width: 118%;
  position: absolute;
  max-width: none;
  object-fit: contain;
  transform: translateY(-50%) rotate(-2deg) translateX(-25%);
  top: 50%;
  left: 0;
  filter:
    drop-shadow(0 24px 28px rgba(40,25,15,0.20))
    drop-shadow(0 8px 10px rgba(40,25,15,0.10));
  transition: transform .5s cubic-bezier(.2,.8,.2,1);
  z-index: 3;
}
.burger-banner:hover .burger-visual img {
  transform: rotate(-2deg) scale(1.025) translateY(-4px);
}
.burger-label {
  position: absolute;
  top: 28px;
  left: 32px;
  z-index: 4;
  color: #B84A24;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-family: var(--font-comfortaa);
}
.burger-products {
  position: relative;
  z-index: 5;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  align-items: stretch;
  padding: 30px 30px 30px 0;
}
.product-card {
  min-height: 330px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 24px;
  background: rgba(255,247,238,0.78);
  border: 1px solid rgba(255,255,255,0.65);
  border-radius: 24px;
  box-shadow: 0 14px 35px rgba(54,36,20,0.08);
  backdrop-filter: blur(12px);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.product-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 20px 48px rgba(54,36,20,0.14);
}
.product-calories {
  align-self: flex-start;
  padding: 6px 11px;
  margin-bottom: 10px;
  border-radius: 999px;
  background: #7A1020;
  color: #fff;
  font-size: 12px;
  font-weight: 600;
  font-family: var(--font-comfortaa);
}
.product-card h3 {
  margin: 0 0 10px;
  color: #6B1220;
  font-size: 32px;
  line-height: 1.1;
  letter-spacing: -0.025em;
  font-family: var(--font-nunito);
  font-weight: 900;
}
.product-card p {
  margin: 0;
  color: #5C3D1E;
  font-size: 18px;
  line-height: 1.55;
  font-family: var(--font-nunito);
  font-weight: 800;
}
.product-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: auto;
  padding-top: 16px;
}
.product-price {
  color: #7A1020;
  font-size: 28px;
  font-weight: 700;
  letter-spacing: -0.03em;
  font-family: var(--font-nunito);
}
.product-button {
  height: 42px;
  padding: 0 20px;
  border: 1.5px solid #7A1020;
  border-radius: 999px;
  background: transparent;
  color: #7A1020;
  font-size: 19px;
  font-weight: 800;
  cursor: pointer;
  font-family: var(--font-nunito);
  transition: background .2s ease, color .2s ease, transform .2s ease;
}
.product-button:hover {
  background: #7A1020;
  color: #fff;
  transform: translateY(-1px);
}
.burger-title {
  font-family: var(--font-nunito);
  font-size: clamp(52px, 5vw, 80px);
  font-weight: 800;
  background: linear-gradient(90deg, #E96B35 0%, #D51862 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: -0.04em;
  line-height: 1.2;
  padding-bottom: 8px;
  margin: 0 0 24px 0;
}
@media (max-width: 1000px) {
  .burger-banner { grid-template-columns: 35% 65%; }
  .burger-products { gap: 12px; padding-right: 18px; }
  .product-card { padding: 20px; }
  .burger-visual img { width: 125%; }
}
@media (max-width: 700px) {
  .burger-banner {
    display: flex;
    flex-direction: column;
    width: calc(100vw - 24px);
    min-height: auto;
    border-radius: 24px;
  }
  .burger-visual { display: none; }
  .burger-mobile-photo { display: block; width: 100%; height: 260px; overflow: hidden; border-radius: 20px 20px 0 0; }
  .burger-mobile-photo img { width: 100%; height: 100%; object-fit: contain; object-position: center; }
  .burger-label { top: 20px; left: 20px; }
  .burger-products {
    display: flex;
    overflow-x: auto;
    padding: 16px;
    gap: 12px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .burger-products::-webkit-scrollbar { display: none; }
  .product-card { flex: 0 0 260px; min-height: 300px; scroll-snap-align: start; }
}

.burger-right {
  position: relative;
  z-index: 5;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 40px 40px 40px 120px;
  overflow: hidden;
}

.dish-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.dish-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 16px 0;
  border-bottom: 1px solid rgba(107,18,32,0.10);
}

.dish-row--last {
  border-bottom: none;
}

.dish-row-main {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
  min-width: 0;
}

.dish-row-name {
  margin: 4px 0 2px;
  color: #5C2000;
  font-size: 27px;
  font-weight: 900;
  font-family: var(--font-nunito);
  line-height: 1.15;
  letter-spacing: -0.02em;
  text-shadow: 0 0 8px rgba(255,255,255,0.9), 0 0 16px rgba(255,255,255,0.7);
}

.dish-row-composition {
  margin: 0;
  color: #2C1A0A;
  font-size: 19px;
  line-height: 1.5;
  font-family: var(--font-nunito);
  font-weight: 700;
  opacity: 1;
  text-shadow: 0 0 6px rgba(255,255,255,0.9), 0 0 12px rgba(255,255,255,0.7);
}

.dish-row-footer {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}

.nophoto-banner {
  grid-template-columns: 1fr;
}

.nophoto-right {
  padding: 40px 60px;
}

.nophoto-right .burger-title {
  text-align: center;
}

.dish-subheader {
  font-family: var(--font-nunito);
  font-size: 20px;
  font-weight: 800;
  color: #6B1220;
  padding: 16px 0 4px;
  letter-spacing: -0.01em;
}

.burger-banner {
  scroll-margin-top: 108px;
}

main { padding-bottom: 60px; }


/* MOBILE ADAPTIVE */
.hidden-mobile { display: flex; }
.show-mobile { display: none; }

@media (max-width: 700px) {
  .hidden-mobile { display: none !important; }
  .show-mobile { display: flex !important; }
}


@media (max-width: 767px) {
  [src*="/brushes/"] {
    width: clamp(200px, 70vw, 300px) !important;
  }
}

.favorite-heart {
  display: block;
  transition: transform 0.18s ease, filter 0.18s ease;
}

.favorite-heart:hover {
  transform: scale(1.12);
}

.favorite-heart.active {
  filter: drop-shadow(0 3px 5px rgba(229, 47, 99, 0.22));
}

.favorite-heart.active:hover {
  transform: scale(1.16);
}

@keyframes btn-bounce {
  0%   { transform: scale(1); }
  35%  { transform: scale(0.88); }
  70%  { transform: scale(1.13); }
  100% { transform: scale(1); }
}
.product-button--bounce {
  animation: btn-bounce 0.35s ease;
}



/* FOOTER MOBILE */

/* ===== MOBILE ADAPTIVE: HOW IT WORKS ===== */
@media (max-width: 700px) {
  .hiw-header {
    margin-bottom: 32px !important;
    background: rgba(255,255,255,0.82) !important;
    border-radius: 20px !important;
    padding: 20px 16px !important;
  }
  .hiw-header h1 {
    font-size: 28px !important;
  }
  .hiw-header p {
    font-size: 16px !important;
  }
  .hiw-header-btns {
    flex-direction: column !important;
    align-items: center !important;
    gap: 10px !important;
  }
  .hiw-header-btn {
    width: 180px !important;
    height: 40px !important;
    padding: 0 !important;
    font-size: 15px !important;
    text-align: center !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-sizing: border-box !important;
    white-space: nowrap !important;
  }
  .hiw-step {
    padding: 16px !important;
    gap: 12px !important;
    border-radius: 20px !important;
  }
  .hiw-step > div:first-child {
    min-width: 44px !important;
    width: 44px !important;
    height: 44px !important;
    font-size: 16px !important;
  }
  .hiw-step > div:last-child > div:first-child {
    font-size: 17px !important;
  }
  .hiw-step > div:last-child {
    flex: 1 1 0 !important;
    min-width: 0 !important;
  }
  .hiw-btn {
    width: 180px !important;
    height: 40px !important;
    padding: 0 !important;
    font-size: 15px !important;
    text-align: center !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-sizing: border-box !important;
    white-space: nowrap !important;
  }
}


/* ===== MOBILE ADAPTIVE: ALL INNER PAGES ===== */
@media (max-width: 700px) {
  .hiw-header {
    margin-bottom: 32px !important;
    background: rgba(255,255,255,0.82) !important;
    border-radius: 20px !important;
    padding: 20px 16px !important;
  }
  .sub-header {
    font-size: 32px !important;
    background: rgba(255,255,255,0.82) !important;
    border-radius: 20px !important;
    padding: 16px !important;
    display: block !important;
  }
  .hiw-header h1 {
    font-size: 32px !important;
  }
  .hiw-btn {
    font-size: 13px !important;
    padding: 10px 18px !important;
    white-space: nowrap !important;
    display: inline-block !important;
  }
  .sub-btn-group {
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 10px !important;
  }
  .sub-btn-group a,
  .sub-btn-group button {
    width: 100% !important;
    text-align: center !important;
    box-sizing: border-box !important;
    white-space: normal !important;
    padding: 14px 20px !important;
  }
  .sub-card {
    padding: 20px 16px !important;
    border-radius: 16px !important;
  }
  .hiw-step {
    padding: 16px 8px 16px 16px !important;
    gap: 12px !important;
  }
  .hiw-step > div:first-child {
    min-width: 44px !important;
    width: 44px !important;
    height: 44px !important;
    font-size: 16px !important;
  }
  .hiw-step > div:last-child > div:first-child {
    font-size: 17px !important;
  }
  .hiw-step > div:last-child {
    flex: 1 1 0 !important;
    min-width: 0 !important;
    display: block !important;
  }
  .hiw-step .hiw-btn {
    white-space: nowrap !important;
    font-size: 12px !important;
    padding: 8px 14px !important;
    display: block !important;
    width: fit-content !important;
  }
  .hiw-header-btn {
    display: block !important;
    width: 100% !important;
    box-sizing: border-box !important;
    text-align: center !important;
    font-size: 16px !important;
    padding: 14px 24px !important;
    white-space: normal !important;
  }
}

/* SUB DISH ROW MOBILE */
@media (max-width: 700px) {
  .sub-dish-row {
    flex-direction: column !important;
    align-items: flex-start !important;
    gap: 4px !important;
    padding: 10px 12px !important;
  }
  .sub-dish-prices {
    flex-direction: row !important;
    gap: 16px !important;
    width: 100% !important;
  }
  .sub-dish-prices span {
    min-width: unset !important;
    text-align: left !important;
  }
}

/* SUB BUTTONS MOBILE */
@media (max-width: 700px) {
  .sub-btn-group {
    flex-direction: column !important;
    align-items: center !important;
    gap: 10px !important;
  }
  .sub-btn-group a,
  .sub-btn-group button {
    width: 180px !important;
    height: 40px !important;
    padding: 0 !important;
    font-size: 15px !important;
    white-space: nowrap !important;
    text-align: center !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-sizing: border-box !important;
  }
}

/* FOOTER MOBILE */

/* FOOTER MOBILE */
@media (max-width: 700px) {
  .footer-wrap {
    padding: 40px 20px 24px !important;
  }
  .footer-grid {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    gap: 32px !important;
  }
  .footer-grid > div {
    padding-top: 0 !important;
    text-align: center !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    width: 100% !important;
  }
  .del-input-group {
    flex-direction: column !important;
    align-items: flex-start !important;
  }
  .del-input-group input {
    width: 100% !important;
    box-sizing: border-box !important;
    min-width: unset !important;
  }

  .footer-grid > div.footer-links-all {
    display: grid !important;
    grid-template-columns: auto auto !important;
    gap: 0 16px !important;
    width: 100% !important;
    flex-direction: unset !important;
    justify-content: space-between !important;
  }
  .footer-links-col {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
  }
  .footer-link {
    font-family: Manrope, sans-serif !important;
    font-size: 15px !important;
    font-weight: 400 !important;
    color: #252525 !important;
    text-decoration: none !important;
    line-height: 2.2 !important;
    text-align: center !important;
  }
  .footer-grid > div:last-child > div {
    justify-content: center !important;
  }
}

/* DELIVERY MOBILE */
@media (max-width: 768px) {
  .del-h1 {
    font-size: 28px !important;
    background: rgba(255,255,255,0.82) !important;
    border-radius: 20px !important;
    padding: 16px !important;
    display: block !important;
    line-height: 1.3 !important;
  }
  .del-sub {
    font-size: 15px !important;
  }
  .del-hero {
    margin-bottom: 32px !important;
  }
  .del-card {
    padding: 20px 16px !important;
    border-radius: 16px !important;
  }
  .del-btn-group {
    flex-direction: column !important;
    align-items: center !important;
    gap: 10px !important;
    display: flex !important;
  }
  .del-btn-group a,
  .del-btn-group button {
    padding: 10px 18px !important;
    font-size: 14px !important;
    white-space: nowrap !important;
    text-align: center !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-sizing: border-box !important;
    height: auto !important;
  }
  .del-input-group {
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 10px !important;
    display: flex !important;
  }
  .del-input-group input {
    width: 100% !important;
    box-sizing: border-box !important;
    min-width: unset !important;
    padding: 14px 20px !important;
    font-size: 16px !important;
    border-radius: 50px !important;
  }
  .del-input-group a,
  .del-input-group button {
    width: 100% !important;
    box-sizing: border-box !important;
    text-align: center !important;
    display: block !important;
    padding: 14px 20px !important;
    font-size: 16px !important;
    border-radius: 50px !important;
  }
  .del-status-row {
    gap: 12px !important;
  }
}
