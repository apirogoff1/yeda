@tailwind base;
html, body { margin: 0; padding: 0; overflow-x: hidden; box-sizing: border-box; }
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: #FFE4E8;
    --foreground: #171717;
    --card: #FFFFFF;
    --card-foreground: oklch(0.1 0 0);
    --popover: oklch(1 0 0);
    --popover-foreground: oklch(0.1 0 0);
    --primary: #E85D3F;
    --primary-foreground: oklch(0.985 0 0);
    --secondary: #EFEAE2;
    --secondary-foreground: oklch(0.205 0 0);
    --muted: oklch(0.97 0 0);
    --muted-foreground: oklch(0.4 0 0);
    --accent: oklch(0.97 0 0);
    --accent-foreground: oklch(0.205 0 0);
    --destructive: oklch(0.577 0.245 27.325);
    --border: oklch(0.922 0 0);
    --input: oklch(0.922 0 0);
    --ring: oklch(0.708 0 0);
    --radius: 0.625rem;
  }
  .dark {
    --background: oklch(0.145 0 0);
    --foreground: oklch(0.985 0 0);
    --card: oklch(0.205 0 0);
    --card-foreground: oklch(0.985 0 0);
    --popover: oklch(0.205 0 0);
    --popover-foreground: oklch(0.985 0 0);
    --primary: oklch(0.922 0 0);
    --primary-foreground: oklch(0.205 0 0);
    --secondary: oklch(0.269 0 0);
    --secondary-foreground: oklch(0.985 0 0);
    --muted: oklch(0.269 0 0);
    --muted-foreground: oklch(0.708 0 0);
    --accent: oklch(0.269 0 0);
    --accent-foreground: oklch(0.985 0 0);
    --destructive: oklch(0.704 0.191 22.216);
    --border: oklch(1 0 0 / 10%);
    --input: oklch(1 0 0 / 15%);
    --ring: oklch(0.556 0 0);
  }
  * {
    border-color: var(--border);
  }
  body {
    background-color: var(--background);
    color: var(--foreground);
  }
}

/* Улучшенная читаемость текста */
p, li, span, div {
  color: inherit;
}
.text-gray-500 { color: #1e3a5f !important; font-weight: 400; }
.text-gray-600 { color: #1e3a5f !important; font-weight: 400; }
.text-gray-700 { color: #1e3a5f !important; font-weight: 400; }

@keyframes pulse-bright {
  0%, 100% { filter: brightness(1); }
  50% { filter: brightness(1.4); }
}
.nav-pulse {
  animation: pulse-bright 2s ease-in-out infinite;
}
input::placeholder { color: #9B111E; font-weight: 800; opacity: 1; }

.max-tooltip-wrap:hover .max-tooltip { opacity: 1 !important; }

/* BURGER BANNER */
.burger-banner {
  position: relative;
  display: grid;
  grid-template-columns: 38% 62%;
  width: min(1280px, calc(100vw - 64px));
  min-height: 440px;
  margin: 0 auto;
  background: #F7EBDD;
  border-radius: 32px;
  overflow: hidden;
  isolation: isolate;
}
.burger-banner::before {
  content: "";
  position: absolute;
  width: 520px;
  height: 520px;
  left: -120px;
  top: -160px;
  background: #E96B35;
  opacity: 0.16;
  border-radius: 43% 57% 62% 38% / 41% 39% 61% 59%;
  transform: rotate(-18deg);
  z-index: 0;
}
.burger-banner::after {
  content: "";
  position: absolute;
  width: 340px;
  height: 260px;
  left: 180px;
  bottom: -150px;
  background: #F2B52F;
  opacity: 0.12;
  border-radius: 50%;
  filter: blur(8px);
  z-index: 0;
}
.burger-visual {
  position: relative;
  min-height: 440px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
  z-index: 3;
}
.burger-visual img {
  position: absolute;
  width: 118%;
  max-width: none;
  left: -7%;
  bottom: -7%;
  object-fit: contain;
  transform: rotate(-2deg);
  filter:
    drop-shadow(0 24px 28px rgba(40,25,15,0.20))
    drop-shadow(0 8px 10px rgba(40,25,15,0.10));
  transition: transform .5s cubic-bezier(.2,.8,.2,1);
  z-index: 3;
}
.burger-banner:hover .burger-visual img {
  transform: rotate(-2deg) scale(1.025) translateY(-4px);
}
.burger-label {
  position: absolute;
  top: 28px;
  left: 32px;
  z-index: 4;
  color: #B84A24;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-family: var(--font-comfortaa);
}
.burger-products {
  position: relative;
  z-index: 5;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  align-items: center;
  padding: 30px 30px 30px 0;
}
.product-card {
  min-height: 330px;
  display: flex;
  flex-direction: column;
  padding: 24px;
  background: rgba(255,255,255,0.88);
  border: 1px solid rgba(255,255,255,0.65);
  border-radius: 24px;
  box-shadow: 0 14px 35px rgba(54,36,20,0.08);
  backdrop-filter: blur(12px);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.product-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 20px 48px rgba(54,36,20,0.14);
}
.product-calories {
  align-self: flex-start;
  padding: 6px 11px;
  margin-bottom: 18px;
  border-radius: 999px;
  background: #FBE4ED;
  color: #D51862;
  font-size: 12px;
  font-weight: 600;
  font-family: var(--font-comfortaa);
}
.product-card h3 {
  margin: 0 0 10px;
  color: #282626;
  font-size: 23px;
  line-height: 1.1;
  letter-spacing: -0.025em;
  font-family: var(--font-comfortaa);
  font-weight: 900;
}
.product-card p {
  margin: 0;
  color: #5B5755;
  font-size: 15px;
  line-height: 1.5;
  font-family: var(--font-comfortaa);
  font-weight: 600;
}
.product-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: auto;
  padding-top: 16px;
}
.product-price {
  color: #C8175B;
  font-size: 26px;
  font-weight: 500;
  letter-spacing: -0.03em;
  font-family: var(--font-comfortaa);
}
.product-button {
  height: 42px;
  padding: 0 20px;
  border: 1.5px solid #D51862;
  border-radius: 999px;
  background: transparent;
  color: #D51862;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  font-family: var(--font-comfortaa);
  transition: background .2s ease, color .2s ease, transform .2s ease;
}
.product-button:hover {
  background: #D51862;
  color: #fff;
  transform: translateY(-1px);
}
.burger-title {
  font-family: var(--font-comfortaa);
  font-size: clamp(42px, 4vw, 64px);
  font-weight: 500;
  color: #242323;
  letter-spacing: -0.04em;
  line-height: 1;
  margin: 0 0 20px 0;
}
@media (max-width: 1000px) {
  .burger-banner { grid-template-columns: 35% 65%; }
  .burger-products { gap: 12px; padding-right: 18px; }
  .product-card { padding: 20px; }
  .burger-visual img { width: 125%; }
}
@media (max-width: 700px) {
  .burger-banner {
    display: flex;
    flex-direction: column;
    width: calc(100vw - 24px);
    min-height: auto;
    border-radius: 24px;
  }
  .burger-visual { height: 300px; min-height: 300px; }
  .burger-visual img { width: 100%; left: 0; bottom: -5%; }
  .burger-label { top: 20px; left: 20px; }
  .burger-products {
    display: flex;
    overflow-x: auto;
    padding: 16px;
    gap: 12px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .burger-products::-webkit-scrollbar { display: none; }
  .product-card { flex: 0 0 260px; min-height: 300px; scroll-snap-align: start; }
}
