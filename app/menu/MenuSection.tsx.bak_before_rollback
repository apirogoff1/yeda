import React from "react"
interface Dish {
  name: string
  composition: string
  kcal: number
  price: number
}
interface MenuSectionProps {
  id: string
  title: string
  emoji: string
  photo: string
  dishes: Dish[]
  grad: string
  shadow: string
  accentColor: string
  photoScale?: number
}
export default function MenuSection({ id, title, emoji, photo, dishes, grad, shadow, accentColor, photoScale = 1 }: MenuSectionProps) {
  return (
    <div style={{ marginBottom: "120px", padding: "0 32px" }}>
      <section id={id} className="burger-banner">
        <div className="burger-mobile-photo">
          <img src={photo} alt={title} />
        </div>
        <div className="burger-visual">
          <img src={photo} alt={title} style={{ transform: `scale(${photoScale})`, transformOrigin: "center center" }} />
        </div>
        <div style={{ display: "flex", flexDirection: "column", justifyContent: "center", padding: "30px 30px 30px 0" }}>
          <div className="burger-title">{title}</div>
          <div style={{ position: "relative" }}>
            <div className="burger-products" style={{ padding: 0 }}>
              {dishes.map((dish, i) => (
                <DishCard key={i} dish={dish} />
              ))}
            </div>
            <div className="show-mobile" style={{ position: "absolute", right: 0, top: "50%", pointerEvents: "none", zIndex: 10, animation: "swipe-fade 3s ease-in-out infinite" }}>
              <span style={{ fontSize: "42px", color: "#FF4500", fontWeight: "bold", display: "block", letterSpacing: "-8px" }}>&#10095;</span>
            </div>
          </div>
        </div>
      </section>
    </div>
  )
}
function DishCard({ dish }: { dish: { name: string; composition: string; kcal: number; price: number } }) {
  return (
    <article className="product-card">
      <span className="product-calories">{dish.kcal} ккал</span>
      <h3>{dish.name}</h3>
      <p>{dish.composition}</p>
      <div className="product-footer">
        <span className="product-price">{dish.price}₽</span>
        <button className="product-button">В корзину</button>
      </div>
    </article>
  )
}
