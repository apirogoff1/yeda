      {pageDekor_drops.map((d, i) => (
        <img key={i} src={d.src} alt="" style={{ position: "absolute", top: d.top, left: d.left, width: d.w, transform: `rotate(${d.rotate}deg)`, pointerEvents: "none" }} />
