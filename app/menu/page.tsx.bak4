                <span style={{ fontFamily: "var(--font-comfortaa)", fontSize: "clamp(12px, 1.3vw, 15px)", fontWeight: 900, color: "#fff", letterSpacing: "1px", textShadow: "0 1px 4px rgba(0,0,0,0.3)", whiteSpace: "nowrap" }}>
