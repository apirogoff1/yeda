      <nav style={{ overflow: "hidden", position: "relative", zIndex: 10, padding: "0 40px 80px" }}>
        <div style={{ display: "flex", flexDirection: "column", alignItems: "center", gap: "0px" }}>
          {/* Ряд 1 - 8 кнопок */}
          <div style={{ display: "flex", gap: "16px", marginBottom: "24px" }}>
            {[
              { id: "VSE", label: "ВСЁ", grad: "linear-gradient(135deg, #B91C1C 0%, #DC2626 40%, #F97316 100%)", shadow: "0 4px 20px rgba(185,28,28,0.5)" },
              { id: "BURGERY", label: "БУРГЕРЫ", grad: "linear-gradient(135deg, #9D174D 0%, #BE185D 45%, #F43F5E 100%)", shadow: "0 4px 20px rgba(157,23,77,0.5)" },
              { id: "PIZZA", label: "ПИЦЦА", grad: "linear-gradient(135deg, #C2410C 0%, #EA580C 45%, #FBBF24 100%)", shadow: "0 4px 20px rgba(194,65,12,0.5)" },
              { id: "ROLLY", label: "РОЛЛЫ", grad: "linear-gradient(135deg, #075985 0%, #0284C7 45%, #38BDF8 100%)", shadow: "0 4px 20px rgba(7,89,133,0.5)" },
              { id: "SALATY", label: "САЛАТЫ", grad: "linear-gradient(135deg, #14532D 0%, #15803D 45%, #4ADE80 100%)", shadow: "0 4px 20px rgba(20,83,45,0.5)" },
              { id: "PASTA", label: "ПАСТА", grad: "linear-gradient(135deg, #92400E 0%, #B45309 45%, #F59E0B 100%)", shadow: "0 4px 20px rgba(146,64,14,0.5)" },
              { id: "SUPY", label: "СУПЫ", grad: "linear-gradient(135deg, #78350F 0%, #B45309 45%, #EAB308 100%)", shadow: "0 4px 20px rgba(120,53,15,0.5)" },
              { id: "ZAKUSKI", label: "ЗАКУСКИ", grad: "linear-gradient(135deg, #7F1D1D 0%, #B91C1C 45%, #EF4444 100%)", shadow: "0 4px 20px rgba(127,29,29,0.5)" },
            ].map((cat) => (
              <a key={cat.id} href={`#${cat.id}`}
                style={{
                  display: "inline-flex", alignItems: "center", justifyContent: "center",
                  textDecoration: "none", background: cat.grad, boxShadow: cat.shadow,
                  borderRadius: "100px", padding: "12px 24px",
                  transition: "transform 0.2s ease", cursor: "pointer", whiteSpace: "nowrap",
                }}
