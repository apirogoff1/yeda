                <h3 style={{ fontFamily: font1, fontSize: '24px', fontWeight: 900, color: accent, marginBottom: '4px' }}>{plan.name}</h3>
                <p style={{ fontFamily: font2, fontSize: '15px', color: muted, marginBottom: '12px' }}>{plan.sub}</p>
                <p style={{ fontFamily: font1, fontSize: '28px', fontWeight: 900, color: dark, marginBottom: '20px' }}>{plan.price}</p>
                <div style={{ display: 'flex', flexDirection: 'column', gap: '10px', marginBottom: '28px' }}>
