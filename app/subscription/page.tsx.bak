        'Regulyarnye zakazy',
        'Personalnye rekomendatsii',
        'Dostup k spetsialnym predlozheniyam',
        'Bonusy za zakazy',
      ],
      btn: 'Vybrat Start',
      popular: false,
    },
    {
      name: 'YEDA Balance',
      sub: 'Dlya tekh, kto zakazyvaet regulyarno',
      price: '[tsena] ₽/mes.',
      features: [
        'Vsyo iz Start',
        'Rasshirennye rekomendatsii',
        'Spetsialnye tseny na otdelnye blyuda',
