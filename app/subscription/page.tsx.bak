    {
      name: 'YEDA Pro',
      sub: 'Dlya tekh, kto khochet maksimum udobstva',
      price: '[tsena] ₽/mes.',
      features: [
        'Vsyo iz Balance',
        'Personalnyy ratsion',
        'Rasshirennye vozmozhnosti YEDA AI',
