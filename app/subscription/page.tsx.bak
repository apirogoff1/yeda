        </div>

        {/* KAK RABOTAET */}
        <div style={card}>
          <h2 style={{ fontFamily: font1, fontSize: '28px', fontWeight: 900, color: dark, marginBottom: '8px' }}>Kak rabotaet podpiska</h2>
          <p style={{ fontFamily: font2, fontSize: '16px', color: muted, marginBottom: '32px' }}>Nastroili odin raz — dalshe YEDA pomogaet sama</p>
          <div style={{ display: 'flex', flexDirection: 'column', gap: '0' }}>
            {steps.map((step, i) => (
