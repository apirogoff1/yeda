      <img src="/photo_yeda/brushes/brush-ezhevika.png" alt="" style={{ position: 'absolute', top: '775px', right: '-350px', width: '1000px', opacity: 0.35, pointerEvents: 'none', zIndex: 0, transform: 'rotate(-145deg)', filter: 'blur(1.5px)' }} />
      <img src="/photo_yeda/brushes/brush-ezhevika.png" alt="" style={{ position: 'absolute', top: '1550px', left: '-200px', width: '920px', opacity: 0.35, pointerEvents: 'none', zIndex: 0, transform: 'rotate(55deg)', filter: 'blur(1.5px)' }} />
      <img src="/photo_yeda/brushes/brush-ezhevika.png" alt="" style={{ position: 'absolute', top: '2325px', right: '-280px', width: '980px', opacity: 0.35, pointerEvents: 'none', zIndex: 0, transform: 'rotate(-30deg)', filter: 'blur(1.5px)' }} />
      <img src="/photo_yeda/brushes/brush-ezhevika.png" alt="" style={{ position: 'absolute', top: '3100px', left: '-250px', width: '1050px', opacity: 0.35, pointerEvents: 'none', zIndex: 0, transform: 'rotate(80deg)', filter: 'blur(1.5px)' }} />
