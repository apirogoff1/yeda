        </div>

        {/* PREIMUSHCHESTVA */}
        <div style={card}>
          <h2 style={{ fontFamily: font1, fontSize: '28px', fontWeight: 900, color: dark, marginBottom: '8px' }}>Preimushchestva</h2>
          <p style={{ fontFamily: font2, fontSize: '16px', color: muted, marginBottom: '24px' }}>Menshe resheniy — bolshe svobodnogo vremeni</p>
          <div style={{ display: 'flex', flexDirection: 'column', gap: '14px' }}>
