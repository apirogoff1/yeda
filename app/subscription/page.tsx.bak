    { num: '3', title: 'Nastraivaem regulyarnost', text: 'Vybiraete udobnye dni i chastotu zakazov.' },
    { num: '4', title: 'Poluchaete edu', text: 'My napominaem, gotovim i dostavlyaem.' },
