        'Дополнительные условия доставки',
      ],
      btn: 'Выбрать Balance',
      popular: true,
    },
    {
      name: 'YEDA Pro',
      sub: 'Для тех, кто хочет максимум удобства',
      price: '[цена] ₽/мес.',
      features: [
        'Всё из Balance',
        'Персональный рацион',
        'Расширенные возможности YEDA AI',
