      <img src="/photo_yeda/brushes/brush-ezhevika.png" alt="" style={{ position: 'absolute', top: '380px', right: '-350px', width: '1000px', opacity: 0.55, pointerEvents: 'none', zIndex: 0, transform: 'rotate(-145deg)', filter: 'blur(0.5px)', maxWidth: 'none' }} />
      <img src="/photo_yeda/brushes/brush-ezhevika.png" alt="" style={{ position: 'absolute', top: '760px', left: '-200px', width: '920px', opacity: 0.55, pointerEvents: 'none', zIndex: 0, transform: 'rotate(55deg)', filter: 'blur(0.5px)', maxWidth: 'none' }} />
      <img src="/photo_yeda/brushes/brush-ezhevika.png" alt="" style={{ position: 'absolute', top: '1140px', right: '-280px', width: '980px', opacity: 0.55, pointerEvents: 'none', zIndex: 0, transform: 'rotate(-30deg)', filter: 'blur(0.5px)', maxWidth: 'none' }} />
      <img src="/photo_yeda/brushes/brush-ezhevika.png" alt="" style={{ position: 'absolute', top: '1520px', left: '-250px', width: '1050px', opacity: 0.55, pointerEvents: 'none', zIndex: 0, transform: 'rotate(80deg)', filter: 'blur(0.5px)', maxWidth: 'none' }} />
      <img src="/photo_yeda/brushes/brush-ezhevika.png" alt="" style={{ position: 'absolute', top: '1900px', right: '-300px', width: '900px', opacity: 0.55, pointerEvents: 'none', zIndex: 0, transform: 'rotate(-170deg)', filter: 'blur(0.5px)', maxWidth: 'none' }} />
      <img src="/photo_yeda/brushes/brush-ezhevika.png" alt="" style={{ position: 'absolute', top: '2280px', left: '-180px', width: '970px', opacity: 0.55, pointerEvents: 'none', zIndex: 0, transform: 'rotate(40deg)', filter: 'blur(0.5px)', maxWidth: 'none' }} />
      <img src="/photo_yeda/brushes/brush-ezhevika.png" alt="" style={{ position: 'absolute', top: '2660px', right: '-350px', width: '1050px', opacity: 0.55, pointerEvents: 'none', zIndex: 0, transform: 'rotate(-60deg)', filter: 'blur(0.5px)', maxWidth: 'none' }} />
      <img src="/photo_yeda/brushes/brush-ezhevika.png" alt="" style={{ position: 'absolute', top: '3040px', left: '-220px', width: '1000px', opacity: 0.55, pointerEvents: 'none', zIndex: 0, transform: 'rotate(25deg)', filter: 'blur(0.5px)', maxWidth: 'none' }} />
      <img src="/photo_yeda/brushes/brush-ezhevika.png" alt="" style={{ position: 'absolute', top: '3420px', right: '-320px', width: '940px', opacity: 0.55, pointerEvents: 'none', zIndex: 0, transform: 'rotate(-110deg)', filter: 'blur(0.5px)', maxWidth: 'none' }} />

