              <div key={i} style={{ display: 'flex', gap: '24px', paddingBottom: '32px' }}>
                <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', minWidth: '40px' }}>
                  <div style={{ width: '36px', height: '36px', borderRadius: '50%', background: accent, color: '#fff', fontFamily: font1, fontWeight: 900, fontSize: '16px', display: 'flex', alignItems: 'center', justifyContent: 'center', flexShrink: 0 }}>{step.num}</div>
                  {i < steps.length - 1 && <div style={{ width: '2px', flex: 1, background: 'rgba(123,63,160,0.2)', marginTop: '8px' }} />}
                </div>
                <div>
                  <div style={{ fontFamily: font1, fontSize: '18px', fontWeight: 700, color: dark, marginBottom: '6px' }}>{step.title}</div>
                  <div style={{ fontFamily: font2, fontSize: '16px', color: muted, lineHeight: 1.7 }}>{step.text}</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* ПРЕИМУЩЕСТВА */}
        <div className="sub-card" style={card}>
          <h2 style={{ fontFamily: font1, fontSize: '28px', fontWeight: 900, color: dark, marginBottom: '8px' }}>Преимущества</h2>
          <p style={{ fontFamily: font2, fontSize: '16px', color: muted, marginBottom: '24px' }}>Меньше решений — больше свободного времени</p>
          <div style={{ display: 'flex', flexDirection: 'column', gap: '14px' }}>
            {[
              'Не нужно каждый раз искать, что заказать',
              'Персональные рекомендации',
              'Регулярная доставка',
              'Бонусы и специальные условия',
              'Удобное управление в личном кабинете',
            ].map((item, i) => (
              <div key={i} style={{ display: 'flex', gap: '12px', alignItems: 'center' }}>
                <div style={{ width: '8px', height: '8px', borderRadius: '50%', background: accent, flexShrink: 0 }} />
                <span style={{ fontFamily: font2, fontSize: '17px', color: muted }}>{item}</span>
              </div>
            ))}
          </div>
        </div>

        {/* FAQ */}
        <div className="sub-card" style={card}>
          <h2 style={{ fontFamily: font1, fontSize: '28px', fontWeight: 900, color: dark, marginBottom: '24px' }}>FAQ по подписке</h2>
          <div style={{ display: 'flex', flexDirection: 'column', gap: '20px' }}>
            {faqs.map((faq, i) => (
              <div key={i} style={{ borderLeft: `3px solid ${accent}`, paddingLeft: '20px' }}>
