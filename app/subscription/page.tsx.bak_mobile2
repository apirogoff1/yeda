        </div>

        {/* ТАРИФЫ */}
        <div id="plans" style={{ marginBottom: '40px' }}>
          <h2 style={{ fontFamily: font1, fontSize: '32px', fontWeight: 900, color: dark, marginBottom: '32px', textAlign: 'center' }}>Тарифы</h2>
          <div style={{ display: 'flex', flexDirection: 'column', gap: '24px' }}>
