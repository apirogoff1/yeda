                </div>
                <div className="sub-btn-group" style={{ display: 'flex', gap: '12px', flexWrap: 'wrap' }}>
                  <a href="#" style={btn}>{plan.btn}</a>
                  <a href={`/ai-chat?plan=${plan.name}`} style={btnOutline}>Подобрать с AI</a>
                </div>
              </div>
            ))}
