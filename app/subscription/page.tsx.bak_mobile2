        </div>

        {/* CTA */}
        <div style={{ ...card, textAlign: 'center', marginBottom: 0 }}>
          <h2 style={{ fontFamily: font1, fontSize: '28px', fontWeight: 900, color: dark, marginBottom: '16px' }}>Попробуем подобрать ваш ритм?</h2>
