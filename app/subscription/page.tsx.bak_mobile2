                    <div style={{ display: 'flex', alignItems: 'center', gap: '8px', padding: '8px 14px', background: 'rgba(123,63,160,0.12)', borderRadius: '10px', marginBottom: '8px' }}>
                      <div style={{ width: '6px', height: '6px', borderRadius: '50%', background: '#7B3FA0', flexShrink: 0 }} />
                      <span style={{ fontFamily: 'var(--font-comfortaa)', fontSize: '14px', fontWeight: 700, color: '#7B3FA0' }}>{plan.includes}</span>
