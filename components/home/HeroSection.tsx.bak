        <input type="email" placeholder="Ваш email" style={{ fontFamily: 'Inter, sans-serif', fontSize: '16px', padding: '14px 20px', borderRadius: '50px', border: '2px solid #999999', outline: 'none', color: '#333333', width: '100%', backgroundColor: 'rgba(255,255,255,0.5)' }} />
