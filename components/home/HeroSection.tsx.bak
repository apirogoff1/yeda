  { src: '/photo_yeda/vegetables/carrot_1.png', top: 1512, left: 926, w: 218, rotate: 25 },
  { src: '/photo_yeda/vegetables/zucchini_1.png', top: 675, left: 1273, w: 230, rotate: -15 },
