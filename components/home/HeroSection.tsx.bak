          style={{ position: 'absolute', top: v.top, left: v.left, width: v.w, zIndex: 3, pointerEvents: 'none' }}>
          <Image src={v.src} alt="" width={v.w} height={v.w} style={{ objectFit: 'contain', transform: `rotate(${v.rotate}deg)` }} />
