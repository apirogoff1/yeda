            </div>
          ))}
        </div>
      </motion.div>

      {/* BLOCK:block-why */}
      <motion.div initial={{ opacity: 0 }} whileInView={{ opacity: 1 }} viewport={{ once: true }} transition={{ duration: 0.8 }}
        style={{ position: 'absolute', top: 1966, left: 686, zIndex: 10 }}>
        <Image src="/photo_yeda/titles/title-pochemu-vybirayt-klubnika.png" alt="Pochemu vybirayut YEDA" width={274} height={86} style={{ width: '274px', height: 'auto' }} />
      </motion.div>
      {/* BLOCK:block-why-tags */}
      <motion.div initial={{ opacity: 0 }} whileInView={{ opacity: 1 }} viewport={{ once: true }} transition={{ duration: 0.8 }}
        style={{ position: 'absolute', top: 2204, left: 705, zIndex: 10 }}>
        <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
          {[
            ['Свежие ингредиенты', '#1A7A2E'],
            ['Понятный состав', '#FF4D00'],
            ['Прозрачные цены', '#5B2D8E'],
            ['Доставка каждый день', '#29B6F6'],
            ['Поддержка 24/7', '#A855F7'],
          ].map(([s, c], i) => (
            <span key={i} style={pillStyle(c)}>✔ {s}</span>
          ))}
        </div>
      </motion.div>

      {/* BLOCK:block-ai */}
      <motion.div initial={{ opacity: 0 }} whileInView={{ opacity: 1 }} viewport={{ once: true }} transition={{ duration: 0.8 }}
        style={{ position: 'absolute', top: 2086, left: 129, zIndex: 10, maxWidth: '420px' }}>
