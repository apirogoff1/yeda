]

const dishes = [
  { src: '/photo_yeda/illustrations/burger_illustration_2-Photoroom.png', top: 342, left: 914, w: 294, rotate: 8 },
  { src: '/photo_yeda/illustrations/pizza_illustration_1-Photoroom.png', top: 2648, left: 1058, w: 308, rotate: -6 },
  { src: '/photo_yeda/illustrations/sushi_6.png', top: 863, left: 50, w: 294, rotate: 10 },
  { src: '/photo_yeda/illustrations/donat.png', top: 1795, left: 240, w: 304, rotate: 12 },
  { src: '/photo_yeda/illustrations/shish_kebab_2.png', top: 1246, left: 589, w: 300, rotate: -8 },
]

const dishAnimations = [
  { animate: { scaleY: [1, 1.18, 0.88, 1.12, 1] }, transition: { duration: 2.4, repeat: Infinity, ease: 'easeInOut' as const } },
  { animate: { opacity: [1, 0.4, 1] }, transition: { duration: 2.0, repeat: Infinity, ease: 'easeInOut' as const } },
  { animate: { skewX: [-8, 8, -8], skewY: [-4, 4, -4] }, transition: { duration: 2.2, repeat: Infinity, ease: 'easeInOut' as const } },
  { animate: { scale: [1, 1.12, 1] }, transition: { duration: 2.2, repeat: Infinity, ease: 'easeInOut' as const } },
  { animate: { scaleX: [1, 1.12, 0.92, 1.06, 1], scaleY: [1, 0.88, 1.10, 0.95, 1] }, transition: { duration: 2.8, repeat: Infinity, ease: 'easeInOut' as const } },
  { animate: { rotate: [-6, 6, -6] }, transition: { duration: 2.6, repeat: Infinity, ease: 'easeInOut' as const } },
  { animate: { y: [0, -10, 0] }, transition: { duration: 4, repeat: Infinity, ease: 'easeInOut' as const } },
]

const float = (i: number) => ({
  animate: { y: [0, -10, 0] },
  transition: { duration: 4 + i * 0.4, repeat: Infinity, ease: 'easeInOut' as const }
})

export default function HeroSection() {
  return (
    <div style={{ position: 'relative', width: '100%', minHeight: '3200px', overflow: 'hidden', background: '#F5EAD8' }}>
