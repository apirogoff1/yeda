  borderRadius: '50px',
  padding: '8px 20px',
  transform: 'rotate(-1deg)',
})

const brushes = [
  { src: '/photo_yeda/brushes/brush-carrot.png', top: -184, left: 316, w: 900, rotate: -30 },
  { src: '/photo_yeda/brushes/brush-skyblue.png', top: 914, left: 338, w: 880, rotate: -15 },
