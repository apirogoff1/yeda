      <motion.div initial={{ opacity: 0 }} whileInView={{ opacity: 1 }} viewport={{ once: true }} transition={{ duration: 0.8 }}
        style={{ position: 'absolute', top: 2944, left: 937, zIndex: 10 }}>
        <button style={{ fontFamily: 'var(--font-comfortaa)', fontWeight: 900, fontSize: '15px', backgroundColor: '#FF4D00', color: '#fff', border: 'none', borderRadius: '50px', padding: '14px 28px', cursor: 'pointer', whiteSpace: 'nowrap' }}>Подписаться</button>
      </motion.div>

      {/* BLOCK:block-sub-tag-1 */}
      <motion.div initial={{ opacity: 0 }} whileInView={{ opacity: 1 }} viewport={{ once: true }} transition={{ duration: 0.8 }}
