          <span style={pillStyleMob('#FF2D6B')}>\u041e\u0444\u043e\u0440\u043c\u0438\u0442\u0435 \u043f\u043e\u0434\u043f\u0438\u0441\u043a\u0443 \u0438 \u043f\u043e\u043b\u0443\u0447\u0430\u0439\u0442\u0435 \u0441\u0432\u0435\u0436\u0438\u0435 \u0431\u043b\u044e\u0434\u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0435\u043d\u044c</span>
        </motion.div>

        {/* MOB: sub-input */}
        <motion.div initial={{ opacity: 0 }} whileInView={{ opacity: 1 }} viewport={{ once: true }} transition={{ duration: 0.8 }}
          style={{ position: 'absolute', top: 2980, left: 16, zIndex: 10, width: '240px' }}>
          <input type="email" placeholder="\u0412\u0430\u0448 email" style={{ fontFamily: 'Inter, sans-serif', fontSize: '14px', padding: '12px 18px', borderRadius: '50px', border: '2px solid #999999', outline: 'none', color: '#333333', width: '100%', backgroundColor: 'rgba(255,255,255,0.5)' }} />
        </motion.div>

        {/* MOB: sub-btn */}
        <motion.div initial={{ opacity: 0 }} whileInView={{ opacity: 1 }} viewport={{ once: true }} transition={{ duration: 0.8 }}
          style={{ position: 'absolute', top: 3040, left: 16, zIndex: 10 }}>
          <button style={{ fontFamily: 'var(--font-comfortaa)', fontWeight: 900, fontSize: '14px', backgroundColor: '#FF4D00', color: '#fff', border: 'none', borderRadius: '50px', padding: '12px 24px', cursor: 'pointer', whiteSpace: 'nowrap' }}>\u041f\u043e\u0434\u043f\u0438\u0441\u0430\u0442\u044c\u0441\u044f</button>
        </motion.div>

        {/* MOB: footer */}
        <motion.div initial={{ opacity: 0 }} whileInView={{ opacity: 1 }} viewport={{ once: true }} transition={{ duration: 0.8 }}
          style={{ position: 'absolute', top: 3140, left: 16, zIndex: 10 }}>
          <span style={{ fontFamily: 'var(--font-comfortaa)', fontSize: '36px', fontWeight: 900, color: '#FF4D00' }}>YEDA</span>
          <p style={{ fontFamily: 'Inter, sans-serif', fontSize: '13px', color: '#999', marginTop: '12px' }}>\u00a9 2025 YEDA. \u0412\u0441\u0435 \u043f\u0440\u0430\u0432\u0430 \u0437\u0430\u0449\u0438\u0449\u0435\u043d\u044b.</p>
        </motion.div>

      </div>
    </>
  )
}
