  backgroundColor: bg,
  color: '#fff',
  fontFamily: 'Inter, sans-serif',
  fontWeight: 700,
  fontSize: '15px',
  borderRadius: '50px',
  padding: '8px 20px',
  transform: 'rotate(-1deg)',
})

export default function HeroSection() {
