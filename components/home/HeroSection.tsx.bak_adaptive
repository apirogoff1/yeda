          <Image src="/photo_yeda/brushes/brush-blue.png" alt="" width={700} height={420} style={{ position: 'absolute', top: 0, right: -100, width: '40vw', opacity: 0.5, transform: 'rotate(90deg)', pointerEvents: 'none' }} />
